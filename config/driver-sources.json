    { "match": "^Dell", "name": "Dell", "url": "https://www.dell.com/support/home/uk-ua/product-support/servicetag/{serial}/drivers", "fallback": "https://www.dell.com/support/home/uk-ua" },
    { "match": "^LENOVO", "name": "Lenovo", "url": "https://pcsupport.lenovo.com/ua/uk/", "note": "Введіть серійний номер {serial} або встановіть Lenovo Vantage" },
