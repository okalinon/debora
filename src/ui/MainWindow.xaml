<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debora" Width="1340" Height="900" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15"
        Background="#F2F2F7" Foreground="#1D1D1F" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Палітра (світла → темна в Convert-D9XamlTheme):
       тло #F2F2F7, бічна панель #E9E9EE, картки White, текст #1D1D1F, другорядний #6E6E73,
       розділювач #E3E3E8, заливка кнопок #E5E5EA, рамка полів #D1D1D6, акцент #007AFF, виділення #DCEBFF;
       стани: зелений #248A3D, помаранчевий #B25000, червоний #D70015. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <SolidColorBrush x:Key="Muted" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Line" Color="#E3E3E8"/>
    <SolidColorBrush x:Key="Fill" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Label" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Tint" Color="#DCEBFF"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Фокус з клавіатури: акцентна рамка навколо елемента -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate><Border Margin="-3" CornerRadius="9" BorderBrush="#007AFF" BorderThickness="2" Opacity="0.6"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Кнопки (macOS push button) ===== -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="17,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.66"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#007AFF"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Готові набори програм: «пігулки» -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="15,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Margin" Value="0,5,18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#007AFF"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextWrapping="Wrap"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Текст ===== -->
    <Style x:Key="Optional" TargetType="TextBlock">
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="Margin" Value="20,26,0,9"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Intro" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="1100"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ===== Згруповані блоки (inset grouped) ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#E3E3E8"/>
      <Setter Property="Margin" Value="22,0,0,0"/>
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="22,15,20,15"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>

    <!-- ===== Бічна панель: пункти з кольоровими плитками (Background — колір плитки, Tag — значок) ===== -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Margin="12,2" Padding="10,7" CornerRadius="9" Background="Transparent" Cursor="Hand">
              <DockPanel>
                <Border Width="28" Height="28" CornerRadius="7" Background="{TemplateBinding Background}" Margin="0,0,12,0">
                  <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ContentPresenter x:Name="Hd" ContentSource="Header" VerticalAlignment="Center" TextElement.FontSize="15.5" TextElement.Foreground="{TemplateBinding Foreground}"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCDCE1"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#007AFF"/>
                <Setter TargetName="Hd" Property="TextElement.Foreground" Value="#FFFFFF"/>
                <Setter TargetName="Hd" Property="TextElement.FontWeight" Value="Medium"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Вкладки: ліворуч список (поверх панелі з назвою й станом), праворуч великий заголовок і вміст -->
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="272"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel IsItemsHost="True" Margin="0,132,0,0" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Bold" Margin="40,30,40,14"/>
                <ContentPresenter ContentSource="SelectedContent" Margin="20,0,20,0"/>
              </DockPanel>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Поля ===== -->
    <Style TargetType="TextBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderBrush" Value="#D1D1D6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#1D1D1F"/>
      <Setter Property="SelectionBrush" Value="#007AFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="BorderBrush" Value="#E5E5EA"/>
      <Setter Property="Padding" Value="38,10,12,10"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderBrush" Value="#D1D1D6"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="7">
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#6E6E73" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,6,30,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" CornerRadius="7" Padding="11,7" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#007AFF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Прапорці (квадрат із заокругленням, акцентна заливка) ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Padding" Value="10,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" Background="White" BorderBrush="#C7C7CC" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="Mark" Data="M3.5,8.5 L7,12 L13.5,5" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#007AFF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Content" Property="Margin" Value="0"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#007AFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Індикатор виконання: тонка заокруглена смуга ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="Foreground" Value="#007AFF"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
              <Border x:Name="Runner" CornerRadius="3" Background="{TemplateBinding Foreground}" Width="70" HorizontalAlignment="Left" Visibility="Collapsed">
                <Border.RenderTransform><TranslateTransform X="-70"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Runner" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="Run">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-70" To="260" Duration="0:0:1.4"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Run"/></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Тонкі смуги прокрутки ===== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb"><Border x:Name="T" CornerRadius="4" Background="#C7C7CC" Margin="2"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#8E8E93"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="MinWidth" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb></Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb></Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Списки ===== -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" Margin="0,1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E3E3E8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="#E3E3E8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#1D1D1F"/></Trigger></Style.Triggers>
    </Style>

    <!-- ===== Журнал виконання (розгортається) ===== -->
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Chev" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#6E6E73" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                          <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.Foreground="#6E6E73" TextElement.FontWeight="Medium"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Знахідка / пункт: значок стану в колі, заголовок, пояснення, посилання -->
    <DataTemplate x:Key="ItemTemplate">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{Binding Color}" VerticalAlignment="Top" Margin="0,0,14,0">
          <TextBlock Text="{Binding Badge}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Optional}" Foreground="#6E6E73" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <ItemsControl ItemsSource="{Binding Links}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><Button Style="{StaticResource LinkButton}" Content="{Binding Label}" Tag="{Binding Url}" ToolTip="{Binding Url}"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="272"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Бічна панель: тло, назва й ПК угорі, стан і права внизу (пункти — у TabControl поверх) -->
    <Border Grid.RowSpan="2" Background="#E9E9EE" BorderBrush="#DCDCE1" BorderThickness="0,0,1,0"/>
    <DockPanel Margin="24,26,16,0" VerticalAlignment="Top">
      <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="11" Background="#007AFF" VerticalAlignment="Top" Margin="0,2,12,0">
        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="21" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel>
        <TextBlock x:Name="TitleText" Text="Debora" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock x:Name="SystemLine" Foreground="#6E6E73" FontSize="13" TextWrapping="Wrap" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="24,0,18,18">
      <TextBlock x:Name="StatusText" Foreground="#6E6E73" FontSize="14" TextWrapping="Wrap" Text="Готово"/>
      <ProgressBar x:Name="Progress" Margin="0,6,0,0" Height="5" Visibility="Collapsed"/>
      <TextBlock x:Name="AdminBadge" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <Button x:Name="BtnLanguage" Style="{StaticResource LinkButton}" Content="English" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Українська / English"/>
    </StackPanel>

    <TabControl x:Name="Tabs" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0">

      <!-- ================= Огляд ================= -->
      <TabItem Uid="overview" Header="Огляд" Tag="&#xE9D9;" Background="#007AFF">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="28,24">
            <DockPanel>
              <Grid DockPanel.Dock="Left" Width="156" Height="156" Margin="0,0,34,0">
                <Ellipse Stroke="#E5E5EA" StrokeThickness="14" Margin="0"/>
                <Path x:Name="ScoreRing" Stroke="#007AFF" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock x:Name="ScoreText" Text="—" FontFamily="{StaticResource Display}" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="зі 100" Foreground="#6E6E73" FontSize="13" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                </StackPanel>
              </Grid>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="VerdictText" Text="Ще не скановано" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountsText" Style="{StaticResource Intro}" Margin="0,4,0,14"
                           Text="Перевірка займає від 10 секунд до 3 хвилин. «Сканувати й виправити все» одразу виконає безпечні кроки: точку відновлення, виправлення, очищення, оновлення й драйвери."/>
                <WrapPanel>
                  <Button x:Name="BtnFixAll" Style="{StaticResource Primary}" Content="Сканувати й виправити все" Margin="0,0,8,6" ToolTip="Перевірити ПК і виконати всі автоматичні кроки чекліста: точка відновлення, виправлення, очищення, оновлення, драйвери"/>
                  <Button x:Name="BtnScan" Content="Лише сканувати" Margin="0,0,8,6"/>
                  <Button x:Name="BtnDeepScan" Content="Глибоке сканування" Margin="0,0,8,6"/>
                  <Button x:Name="BtnOpenReport" Content="Відкрити звіт" IsEnabled="False" Margin="0,0,8,6"/>
                </WrapPanel>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Margin="0,12,0,0" Padding="24,16">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=CategoryList}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <ItemsControl x:Name="CategoryList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,7,28,7">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding Color}"/>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding Number}" Maximum="100" Height="7" Margin="0,7,0,0" Foreground="{Binding Color}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Grid.Row="2" Style="{StaticResource Section}" Text="Що знайдено"/>
          <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <Grid>
              <ListBox x:Name="FindingsList" ItemTemplate="{StaticResource ItemTemplate}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="440">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=FindingsList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="38" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
                <TextBlock Text="Тут з'являться знахідки" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Натисніть «Лише сканувати», щоб побачити стан ПК без змін, або «Сканувати й виправити все»." Foreground="#6E6E73" TextWrapping="Wrap" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================= Чекліст ================= -->
      <TabItem Uid="checklist" Header="Чекліст" Tag="&#xE9D5;" Background="#34C759">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnRunAuto" Style="{StaticResource Primary}" Content="Виконати автоматичні кроки" Margin="0,0,8,6"/>
            <Button x:Name="BtnMarkDone" Content="Позначити вибраний виконаним" Margin="0,0,8,6"/>
            <Button x:Name="BtnRecheck" Content="Перевірити ще раз" Margin="0,0,8,6"/>
            <Button x:Name="BtnReboot" Content="Перезавантажити ПК" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="ChecklistSummary" Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12" Text="Чекліст з'явиться після сканування."/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <ListBox x:Name="ChecklistList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="0,1,12,0" VerticalAlignment="Top"/>
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="{Binding Color}" FontSize="14" FontWeight="SemiBold" Margin="14,0,0,0"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Optional}" Foreground="#6E6E73" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Optional}" Foreground="#B25000" FontSize="14" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate><Button Style="{StaticResource LinkButton}" Content="{Binding Label}" Tag="{Binding Url}" ToolTip="{Binding Url}"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================= Налаштування (твіки) ================= -->
      <TabItem Uid="settings" Header="Налаштування" Tag="&#xE713;" Background="#8E8E93">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel>
            <ComboBox x:Name="PresetBox" Width="270" Margin="0,0,8,6"/>
            <Button x:Name="BtnSelectPreset" Content="Вибрати профіль" Margin="0,0,8,6"/>
            <Button x:Name="BtnSelectNone" Content="Зняти все" Margin="0,0,8,6"/>
            <Button x:Name="BtnPreview" Content="Що зміниться" Margin="0,0,8,6"/>
            <Button x:Name="BtnApply" Style="{StaticResource Primary}" Content="Застосувати вибране" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="TweaksSummary" Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12" Text="Стан налаштувань завантажується…"/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="TweakGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Налаштування" Binding="{Binding Title}" Width="3*" MinWidth="300" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Категорія" Binding="{Binding Group}" Width="*" MinWidth="70" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Ризик" Width="*" MinWidth="70">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Зараз" Binding="{Binding Status}" Width="*" MinWidth="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Примітка" Binding="{Binding Note}" Width="2*" MinWidth="210" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#6E6E73"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================= Драйвери ================= -->
      <TabItem Uid="drivers" Header="Драйвери" Tag="&#xE772;" Background="#FF9500">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,20">
            <WrapPanel>
              <Button x:Name="BtnDriverScan" Style="{StaticResource Primary}" Content="Перевірити драйвери" Margin="0,0,8,6"/>
              <Button x:Name="BtnOemPage" Content="Сторінка драйверів виробника" IsEnabled="False" Margin="0,0,8,6"/>
              <Button x:Name="BtnOemTool" Content="Утиліта виробника" Visibility="Collapsed" Margin="0,0,8,6" ToolTip="Встановить і запустить фірмову утиліту виробника ПК: драйвери й BIOS саме для вашої моделі"/>
            </WrapPanel>
            <TextBlock x:Name="OemText" Style="{StaticResource Intro}" Margin="4,6,0,0"/>

            <TextBlock Style="{StaticResource Section}" Text="Нові драйвери з інтернету"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Intro}" Margin="0,0,0,10"
                           Text="Debora шукає драйвери для пристроїв без драйвера і новіші версії для решти в офіційному каталозі Microsoft (там драйвери від Intel, AMD, NVIDIA, Realtek та інших) і серед рекомендацій Windows Update. Завантаження перевіряються за контрольною сумою, попередні драйвери зберігаються для відкату."/>
                <WrapPanel>
                  <Button x:Name="BtnDriverOnline" Style="{StaticResource Primary}" Content="Знайти нові драйвери" Margin="0,0,8,6"/>
                  <Button x:Name="BtnDriverOnlineInstall" Content="Завантажити й встановити вибрані" IsEnabled="False" Margin="0,0,8,6"/>
                </WrapPanel>
                <DataGrid x:Name="DriverOnlineGrid" Margin="-6,6,-6,0" MinHeight="40" MaxHeight="320">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="54">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Пристрій" Binding="{Binding Title}" Width="2*" MinWidth="200" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Id}"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Що робити" Width="*" MinWidth="90">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Зараз → нова версія" Binding="{Binding Detail}" Width="2*" MinWidth="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Розмір і джерело" Binding="{Binding Note}" Width="*" MinWidth="110" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#6E6E73"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Пристрої без драйвера або з помилкою"/>
            <Border Style="{StaticResource Panel}">
              <ListBox x:Name="DriverProblemsList" ItemTemplate="{StaticResource ItemTemplate}" MinHeight="44" MaxHeight="320"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Драйвери з папки"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Intro}" Margin="0,0,0,10"
                           Text="Завантажте драйвери з сайту виробника в папку (архіви .zip теж можна). Програма знайде ті, що підходять до цього ПК, пропустить актуальні й поставить у правильному порядку, зберігши попередні для відкату."/>
                <DockPanel>
                  <Button x:Name="BtnFindDrivers" DockPanel.Dock="Right" Content="Знайти драйвери в папці" Margin="8,0,0,0"/>
                  <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="Огляд…" Margin="8,0,0,0"/>
                  <TextBox x:Name="DriverFolder" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="DriverPackageGrid" Margin="-6,10,-6,0" MinHeight="44" MaxHeight="300">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="54">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Пристрій" Binding="{Binding Title}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Що робити" Width="*" MinWidth="70">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Зараз → у папці" Binding="{Binding Detail}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Файл" Binding="{Binding Note}" Width="*" MinWidth="70" IsReadOnly="True"/>
                  </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="BtnInstallDrivers" Style="{StaticResource Primary}" Content="Встановити вибрані драйвери" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Встановлені важливі драйвери"/>
            <Border Style="{StaticResource Panel}">
              <DataGrid x:Name="DriverInstalledGrid" MaxHeight="320">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Тип" Binding="{Binding Group}" Width="*" MinWidth="70" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Пристрій" Binding="{Binding Title}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Версія" Binding="{Binding Status}" Width="*" MinWidth="70" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Дата" Binding="{Binding Detail}" Width="*" MinWidth="70" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Постачальник" Binding="{Binding Note}" Width="*" MinWidth="70" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Програми ================= -->
      <TabItem Uid="apps" Header="Програми" Tag="&#xE71D;" Background="#5856D6">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Grid>
              <TextBox x:Name="AppSearch" Style="{StaticResource Search}" VerticalAlignment="Stretch"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#6E6E73" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="AppSearchHint" Text="Пошук: назва програми або для чого вона (наприклад «pdf», «відео», «vpn»)" Foreground="#8E8E93" FontSize="16" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <TextBlock Style="{StaticResource Section}" Margin="4,14,0,7" Text="Готові набори"/>
            <WrapPanel x:Name="AppBundles"/>
            <TextBlock x:Name="AppsSummary" Style="{StaticResource Intro}" Margin="4,4,0,0"
                       Text="Позначте програми — клацніть по картці — і натисніть «Встановити». Встановлення через winget: офіційні інсталятори, без реклами й «довантажувачів»."/>
            <Button x:Name="BtnWingetStore" Style="{StaticResource LinkButton}" Content="Встановити winget («Інсталятор застосунків») з Microsoft Store" Visibility="Collapsed" HorizontalAlignment="Left" Margin="4,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Margin="0,0,14,10">
              <ListBox x:Name="AppCategoryList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12,8"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#6E6E73" Margin="8,0,0,0"/>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="AppCards">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,12,12" CornerRadius="12" Background="White" ToolTip="{Binding Id}">
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" Padding="12,0,0,0" Margin="16,14" VerticalContentAlignment="Top">
                        <DockPanel>
                          <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Top">
                            <Border CornerRadius="11" Background="#E5E5EA">
                              <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="11" Background="White">
                              <Border.Style>
                                <Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                              </Border.Style>
                              <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                          </Grid>
                          <StackPanel>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16.5" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Note}" Foreground="#6E6E73" TextWrapping="Wrap" FontSize="14" Margin="0,3,0,0" Height="38" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontSize="14" Margin="0,6,0,0" FontWeight="Medium"/>
                          </StackPanel>
                        </DockPanel>
                      </CheckBox>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,4,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnAppsClear" Content="Зняти вибір"/>
              <Button x:Name="BtnAppsRefresh" Content="Перевірити встановлені"/>
              <Button x:Name="BtnAppsUpgrade" Content="Оновити всі програми"/>
              <Button x:Name="BtnAppsInstall" Style="{StaticResource Primary}" Content="Встановити вибрані" IsEnabled="False" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="AppSelectedText" VerticalAlignment="Center" Text="Нічого не вибрано" Foreground="#6E6E73" Margin="4,0,12,0" TextWrapping="Wrap"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Видалення програм ================= -->
      <TabItem Uid="uninstall" Header="Видалення" Tag="&#xE74D;" Background="#FF3B30">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <TextBox x:Name="UninstSearch" Style="{StaticResource Search}" VerticalAlignment="Stretch"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#6E6E73" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="UninstSearchHint" Text="Пошук серед встановлених програм" Foreground="#8E8E93" FontSize="16" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <DockPanel Grid.Row="1" Margin="4,12,0,12">
            <CheckBox x:Name="ChkUninstBloat" DockPanel.Dock="Right" Content="Лише рекомендовані до видалення" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="UninstSummary" Style="{StaticResource Intro}" VerticalAlignment="Center"
                       Text="Позначте програми, які більше не потрібні. Більшість видаляється тихо; для решти відкриється звичайний деінсталятор."/>
          </DockPanel>
          <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="UninstGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Програма" Binding="{Binding Title}" Width="3*" MinWidth="220" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Видавець" Binding="{Binding Group}" Width="2*" MinWidth="120" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Розмір" Binding="{Binding Note}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Встановлено" Binding="{Binding Kind}" Width="130" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Примітка" Width="3*" MinWidth="200">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <DockPanel Grid.Row="3" Margin="0,10,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnUninstRefresh" Content="Оновити список"/>
              <Button x:Name="BtnUninstall" Style="{StaticResource Primary}" Content="Видалити вибрані" IsEnabled="False" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="UninstSelectedText" VerticalAlignment="Center" Foreground="#6E6E73" Margin="4,0,12,0" Text="Нічого не вибрано"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Автозавантаження ================= -->
      <TabItem Uid="startup" Header="Автозавантаження" Tag="&#xE945;" Background="#FF9F0A">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnStartupApply" Style="{StaticResource Primary}" Content="Застосувати зміни" Margin="0,0,8,6"/>
            <Button x:Name="BtnStartupRecommended" Content="Вимкнути рекомендовані" Margin="0,0,8,6" ToolTip="Зняти галочки з програм, яким не потрібно стартувати разом із Windows (лаунчери ігор, «помічники», реклама виробника), і застосувати"/>
            <Button x:Name="BtnStartupRefresh" Content="Оновити список" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="StartupSummary" Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12"
                     Text="Зніміть галочку з програм, яким не потрібно стартувати разом із Windows, і натисніть «Застосувати зміни». Програми не видаляються — лише не запускаються самі; усе відкочується."/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="StartupGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Запускати" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Програма" Binding="{Binding Title}" Width="2*" MinWidth="220" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Видавець" Binding="{Binding Group}" Width="*" MinWidth="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Звідки" Binding="{Binding Note}" Width="*" MinWidth="140" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Примітка" Width="*" MinWidth="140">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================= Обслуговування ================= -->
      <TabItem Uid="maintenance" Header="Обслуговування" Tag="&#xE90F;" Background="#30B0C7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,24" MaxWidth="1240" HorizontalAlignment="Stretch">

            <TextBlock Style="{StaticResource Section}" Margin="16,0,0,7" Text="Стан комп'ютера"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <StackPanel Margin="16,12,14,12">
                  <DockPanel>
                    <Button x:Name="BtnDisksRefresh" DockPanel.Dock="Right" Content="Перевірити" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Стан дисків"/>
                      <TextBlock x:Name="DisksState" Style="{StaticResource RowNote}" Text="Температура, знос SSD, години роботи й помилки (SMART) для кожного диска."/></StackPanel>
                  </DockPanel>
                  <ItemsControl x:Name="DisksList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,10,0,0">
                          <Ellipse DockPanel.Dock="Left" Width="11" Height="11" Fill="{Binding Color}" VerticalAlignment="Top" Margin="2,6,14,0"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Optional}" Foreground="{Binding Color}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource RowNote}"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnRestorePoint" DockPanel.Dock="Right" Content="Створити" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Точка відновлення"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Знімок системи, до якого можна повернутися, якщо після змін щось піде не так."/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Очищення й ремонт"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnCleanNow" DockPanel.Dock="Right" Content="Очистити" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Очищення диска"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Тимчасові файли, кеш оновлень Windows, дампи збоїв і звіти про помилки, залишки інсталяторів драйверів. Кошик не чіпається."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnRepair" DockPanel.Dock="Right" Content="Перевірити й відновити" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Відновлення системних файлів"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="DISM і SFC — коли Windows поводиться дивно, оновлення не ставляться або вбудовані програми не відкриваються. Триває 10–40 хвилин, потрібен інтернет."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnMemoryTest" DockPanel.Dock="Right" Content="Запланувати" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Перевірка оперативної пам'яті"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли бувають сині екрани з різними кодами або падають різні програми. Перевірка запуститься під час наступного перезавантаження (10–20 хвилин), результат покаже сканування."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnSearchReset" DockPanel.Dock="Right" Content="Перебудувати" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Пошуковий індекс Windows"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли пошук у «Пуску» не знаходить файли чи програми або індекс займає гігабайти. Індекс створиться заново у фоні за кілька годин."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnIconCache" DockPanel.Dock="Right" Content="Скинути кеш" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Кеш значків і ескізів"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли замість значків білі аркуші, значки переплутані або ескізи фото застарілі. Провідник перезапуститься (відкриті вікна папок закриються)."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnNetReset" DockPanel.Dock="Right" Content="Скинути мережу" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Скидання мережі"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли Wi-Fi підключено, а сайти не відкриваються: очищення кешу DNS, скидання Winsock і TCP/IP. Потрібне перезавантаження."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnWuReset" DockPanel.Dock="Right" Content="Скинути Windows Update" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Скидання Windows Update"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли оновлення зависли або постійно падають з помилкою: зупинка служб, новий кеш оновлень, запуск служб."/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Оновлення Windows"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="PauseDays" Width="130" Margin="0,0,8,0" SelectedIndex="0">
                      <ComboBoxItem Content="7 днів"/><ComboBoxItem Content="14 днів"/><ComboBoxItem Content="21 день"/><ComboBoxItem Content="35 днів"/>
                    </ComboBox>
                    <Button x:Name="BtnPause" Content="Призупинити"/>
                    <Button x:Name="BtnResume" Content="Відновити" Margin="0"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Пауза оновлень"/>
                    <TextBlock x:Name="PauseState" Style="{StaticResource RowNote}"/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnWuDrivers" DockPanel.Dock="Right" Content="Вимкнути" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Драйвери з Windows Update"/>
                    <TextBlock x:Name="WuDriversState" Style="{StaticResource RowNote}"/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Автоматичне обслуговування"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource RowNote}" Margin="0,0,0,10"
                           Text="Раз на тиждень Debora сама створить точку відновлення й виконає вибране, потім просканує ПК і покаже сповіщення з підсумком. Працює, коли ви увійшли в Windows; пропущений запуск виконається при наступному вході."/>
                <CheckBox x:Name="ChkMtCleanup" Content="Очищення диска (тимчасові файли, кеш оновлень, залишки інсталяторів)" Margin="0,3"/>
                <CheckBox x:Name="ChkMtDefender" Content="Антивірусні бази Захисника" Margin="0,3"/>
                <CheckBox x:Name="ChkMtApps" Content="Оновлення програм (winget)" Margin="0,3"/>
                <CheckBox x:Name="ChkMtDrivers" Content="Новіші драйвери з каталогу Microsoft (лише рекомендовані)" Margin="0,3"/>
                <CheckBox x:Name="ChkMtWindows" Content="Оновлення Windows (зазвичай Windows ставить їх сама)" Margin="0,3"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Коли" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ComboBox x:Name="MtDay" Width="170" Margin="0,0,8,0"/>
                  <TextBox x:Name="MtTime" Width="78" Text="12:00" VerticalContentAlignment="Center"/>
                </StackPanel>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="BtnScheduleOn" Style="{StaticResource Primary}" Content="Увімкнути розклад"/>
                  <Button x:Name="BtnScheduleOff" Content="Вимкнути"/>
                  <Button x:Name="BtnMaintainNow" Content="Виконати зараз"/>
                </WrapPanel>
                <TextBlock x:Name="ScheduleState" Style="{StaticResource RowNote}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Перевстановлення ================= -->
      <TabItem Uid="reinstall" Header="Перевстановлення" Tag="&#xE88E;" Background="#AF52DE">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,24" MaxWidth="1240" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource Intro}" Margin="4,0,0,4"
                       Text="Чиста Windows без зайвих запитань і з усіма драйверами. Створіть звичайну флешку з Windows (Media Creation Tool від Microsoft або Rufus), вставте її й натисніть «Підготувати флешку». Під час встановлення вручну лишиться тільки вибір диска; після першого входу Debora сама застосує налаштування й доставить драйвери з інтернету."/>
            <TextBlock Style="{StaticResource Section}" Text="Інсталяційна флешка"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnUsbRefresh" DockPanel.Dock="Right" Content="Оновити список" Margin="8,0,0,0"/>
                  <ComboBox x:Name="UsbBox"/>
                </DockPanel>
                <TextBlock x:Name="UsbInfo" Style="{StaticResource RowNote}" Margin="16,-4,16,10"/>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <TextBox x:Name="UserNameBox" DockPanel.Dock="Right" Width="380" Text="User"/>
                  <TextBlock Text="Ім'я облікового запису" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <PasswordBox x:Name="AccountPasswordBox" DockPanel.Dock="Right" Width="380"/>
                  <TextBlock Text="Пароль (можна лишити порожнім)" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <ComboBox x:Name="EditionBox" DockPanel.Dock="Right" Width="380" SelectedIndex="0">
                    <ComboBoxItem Content="Вибрати під час встановлення"/>
                    <ComboBoxItem Content="Home (Домашня)"/>
                    <ComboBoxItem Content="Pro"/>
                  </ComboBox>
                  <TextBlock Text="Редакція Windows" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <StackPanel Margin="16,12,14,14">
                  <CheckBox x:Name="ChkUsbDrivers" IsChecked="True" Content="Додати драйвери цього ПК — Windows поставить їх під час встановлення"/>
                  <CheckBox x:Name="ChkUsbBypass" IsChecked="True" Margin="0,8,0,0" Content="Дозволити Windows 11 на старому ПК (без TPM 2.0, Secure Boot, з непідтримуваним процесором)"/>
                  <CheckBox x:Name="ChkUsbPost" IsChecked="True" Margin="0,8,0,0" Content="Після першого входу: рекомендовані налаштування Debora і драйвери з інтернету"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnPrepareUsb" Style="{StaticResource Primary}" Content="Підготувати флешку"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Section}" Text="Резервна копія"/>
            <Border Style="{StaticResource Group}">
              <DockPanel Style="{StaticResource Row}">
                <Button x:Name="BtnExportDrivers" DockPanel.Dock="Right" Content="Зберегти в папку…" VerticalAlignment="Center" Margin="0"/>
                <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Драйвери цього ПК"/>
                  <TextBlock Style="{StaticResource RowNote}" Text="Усі сторонні драйвери в одну папку. Після перевстановлення поставте їх на вкладці «Драйвери» → «Драйвери з папки»."/></StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Журнал ================= -->
      <TabItem Uid="history" Header="Журнал змін" Tag="&#xE81C;" Background="#A2845E">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnUndo" Style="{StaticResource Primary}" Content="Відкотити вибрану сесію" Margin="0,0,8,6"/>
            <Button x:Name="BtnRefreshSessions" Content="Оновити" Margin="0,0,8,6"/>
            <Button x:Name="BtnSystemRestore" Content="Відновлення системи Windows" Margin="0,0,8,6"/>
            <Button x:Name="BtnDiagnostics" Content="Зібрати діагностику" Margin="0,0,8,6" ToolTip="Один zip з відомостями про систему, драйвери, помилки й журнал змін — щоб розібратися з проблемою"/>
          </WrapPanel>
          <TextBlock Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12"
                     Text="Кожне застосування змін — окрема сесія. Відкат повертає саме те, що було до змін; значення, які після цього змінили ви або Windows, не перезаписуються."/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="SessionGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Коли" Binding="{Binding Title}" Width="*" MinWidth="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Що застосовано" Binding="{Binding Detail}" Width="3*" MinWidth="300" IsReadOnly="True"/>
                <DataGridTextColumn Header="Змін" Binding="{Binding Number}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Стан" Binding="{Binding Status}" Width="*" MinWidth="70" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Журнал виконання під вмістом -->
    <Expander x:Name="LogExpander" Grid.Row="1" Grid.Column="1" Header="Журнал виконання" Margin="40,0,40,8">
      <Border Style="{StaticResource Panel}" Margin="0,0,0,6">
        <TextBox x:Name="LogBox" Height="170" VerticalAlignment="Stretch" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
      </Border>
    </Expander>
  </Grid>
</Window>
