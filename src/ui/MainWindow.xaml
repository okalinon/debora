<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debora" Width="1340" Height="900" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="15"
        Background="#F2F2F7" Foreground="#1D1D1F" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- Палітра (світла → темна в Convert-D9XamlTheme):
       тло #F2F2F7, бічна панель #E9E9EE, картки White, текст #1D1D1F, другорядний #6E6E73,
       розділювач #E3E3E8, заливка кнопок #E5E5EA, рамка полів #D1D1D6, акцент #007AFF, виділення #DCEBFF;
       стани: зелений #248A3D, помаранчевий #B25000, червоний #D70015. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <SolidColorBrush x:Key="Muted" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Line" Color="#E3E3E8"/>
    <SolidColorBrush x:Key="Fill" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Label" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Tint" Color="#DCEBFF"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Фокус з клавіатури: акцентна рамка навколо елемента -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate><Border Margin="-3" CornerRadius="9" BorderBrush="#007AFF" BorderThickness="2" Opacity="0.6"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Кнопки (macOS push button) ===== -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="17,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.66"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1D1D1F"/>
      <Setter Property="Foreground" Value="#F2F2F7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Готові набори програм: «пігулки» -->
    <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="15,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Margin" Value="0,5,18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#007AFF"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextWrapping="Wrap"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Текст ===== -->
    <Style x:Key="Optional" TargetType="TextBlock">
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="Margin" Value="20,26,0,9"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="RowNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Intro" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="1100"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ===== Згруповані блоки (inset grouped) ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="22,18"/>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style x:Key="Sep" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#E3E3E8"/>
      <Setter Property="Margin" Value="22,0,0,0"/>
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="22,15,20,15"/>
      <Setter Property="LastChildFill" Value="True"/>
    </Style>

    <!-- ===== Бічна панель: пункти з кольоровими плитками (Background — колір плитки, Tag — значок) ===== -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <!-- Значок і назва вкладки (лише значки були незрозумілі: назва ховалась у підказці) -->
            <Border x:Name="Bd" Height="40" Margin="12,2" Padding="10,0" CornerRadius="10" Background="Transparent" Cursor="Hand">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="#6E6E73" Width="26" VerticalAlignment="Center"/>
                <TextBlock x:Name="Lb" Text="{TemplateBinding Header}" FontSize="14" Foreground="#1D1D1F" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCDCE1"/><Setter TargetName="Ic" Property="Foreground" Value="#1D1D1F"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D1D1F"/><Setter TargetName="Ic" Property="Foreground" Value="#F2F2F7"/><Setter TargetName="Lb" Property="Foreground" Value="#F2F2F7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Вкладки: ліворуч список (поверх панелі з назвою й станом), праворуч великий заголовок і вміст -->
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel IsItemsHost="True" Margin="0,84,0,0" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                           FontFamily="{StaticResource Display}" FontSize="32" FontWeight="Bold" Margin="48,30,40,14"/>
                <ContentPresenter ContentSource="SelectedContent" Margin="28,0,28,0"/>
              </DockPanel>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Поля ===== -->
    <Style TargetType="TextBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderBrush" Value="#D1D1D6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#1D1D1F"/>
      <Setter Property="SelectionBrush" Value="#007AFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="BorderBrush" Value="#E5E5EA"/>
      <Setter Property="Padding" Value="38,10,12,10"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderBrush" Value="#D1D1D6"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="7">
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#6E6E73" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,6,30,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="#D1D1D6" BorderThickness="1" CornerRadius="9" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" CornerRadius="7" Padding="11,7" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#007AFF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Прапорці (квадрат із заокругленням, акцентна заливка) ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Padding" Value="10,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" Background="White" BorderBrush="#C7C7CC" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
                <Path x:Name="Mark" Data="M3.5,8.5 L7,12 L13.5,5" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter x:Name="Content" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#007AFF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#007AFF"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Content" Property="Margin" Value="0"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#007AFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Індикатор виконання: тонка заокруглена смуга ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#E5E5EA"/>
      <Setter Property="Foreground" Value="#007AFF"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
              <Border x:Name="Runner" CornerRadius="3" Background="{TemplateBinding Foreground}" Width="70" HorizontalAlignment="Left" Visibility="Collapsed">
                <Border.RenderTransform><TranslateTransform X="-70"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Runner" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="Run">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-70" To="260" Duration="0:0:1.4"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Run"/></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Тонкі смуги прокрутки ===== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb"><Border x:Name="T" CornerRadius="4" Background="#C7C7CC" Margin="2"/>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#8E8E93"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="MinWidth" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb></Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="False"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb></Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Списки ===== -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" Margin="0,1">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F2F2F7"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E3E3E8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#6E6E73"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="#E3E3E8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCEBFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#1D1D1F"/></Trigger></Style.Triggers>
    </Style>

    <!-- ===== Журнал виконання (розгортається) ===== -->
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="0,8">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Chev" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="#6E6E73" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                          <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.Foreground="#6E6E73" TextElement.FontWeight="Medium"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Знахідка / пункт: значок стану в колі, заголовок, пояснення, посилання -->
    <DataTemplate x:Key="ItemTemplate">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{Binding Color}" VerticalAlignment="Top" Margin="0,0,14,0">
          <TextBlock Text="{Binding Badge}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Optional}" Foreground="#6E6E73" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <ItemsControl ItemsSource="{Binding Links}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><Button Style="{StaticResource LinkButton}" Content="{Binding Label}" Tag="{Binding Url}" ToolTip="{Binding Url}"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#E9E9EE" BorderBrush="#DCDCE1" BorderThickness="0,0,1,0"/>
    <TextBlock Text="Debora" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="80,31,0,0"/>
    <Border Width="42" Height="42" CornerRadius="11" Background="#1D1D1F" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24,22,0,0">
      <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#F2F2F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>    <StackPanel Grid.Row="2" Grid.Column="1" Panel.ZIndex="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,42,0">
      <ProgressBar x:Name="Progress" Width="120" Height="5" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
      <TextBlock x:Name="StatusText" Foreground="#6E6E73" FontSize="13.5" Text="Готово" MaxWidth="360" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock x:Name="AdminBadge" FontSize="13.5" FontWeight="Medium" Margin="16,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <Button x:Name="BtnElevate" Style="{StaticResource LinkButton}" Content="Перезапустити від адміністратора" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Відкрити Debora з правами адміністратора, щоб можна було вносити зміни"/>
      <Button x:Name="BtnSearch" Style="{StaticResource LinkButton}" Content="Пошук (Ctrl+K)" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Знайти налаштування, пункт деблоату, програму чи дію"/>
      <TextBlock x:Name="TitleText" Visibility="Collapsed"/>
      <TextBlock x:Name="SystemLine" Visibility="Collapsed"/>
    </StackPanel>

    <TabControl x:Name="Tabs" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0">

      <!-- ================= Огляд ================= -->
      <TabItem Uid="overview" Header="Огляд" Tag="&#xE9D9;" Background="#007AFF">
        <!-- Уся вкладка — одна сторінка з прокруткою: знахідки показуються повністю, без власної прокрутки -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Padding="28,24">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Margin="0,0,44,0" VerticalAlignment="Center">
                <Path x:Name="ScoreRing" Visibility="Collapsed"/>
                <TextBlock x:Name="ScoreText" Text="—" FontFamily="{StaticResource Display}" FontSize="96" FontWeight="Bold" LineHeight="96" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock Text="зі 100" Foreground="#6E6E73" FontSize="14" Margin="4,2,0,0"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="VerdictText" Text="Ще не скановано" FontFamily="{StaticResource Display}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountsText" Style="{StaticResource Intro}" Margin="0,4,0,14"
                           Text="Перевірка займає від 10 секунд до 3 хвилин. «Сканувати й виправити все» одразу виконає безпечні кроки: точку відновлення, виправлення, очищення, оновлення й драйвери. Кожну знахідку можна виправити й окремо — кнопкою в її рядку."/>
                <WrapPanel>
                  <Button x:Name="BtnFixAll" Style="{StaticResource Primary}" Content="Сканувати й виправити все" Margin="0,0,8,6" ToolTip="Перевірити ПК і виконати все, що Debora виправляє сама: точка відновлення, виправлення, очищення, оновлення, драйвери"/>
                  <Button x:Name="BtnScan" Content="Лише сканувати" Margin="0,0,8,6"/>
                  <Button x:Name="BtnDeepScan" Content="Глибоке сканування" Margin="0,0,8,6"/>
                  <Button x:Name="BtnOpenReport" ToolTipService.ShowOnDisabled="True" ToolTip="Звіт з'явиться після сканування" Content="Відкрити звіт" IsEnabled="False" Margin="0,0,8,6"/>
                </WrapPanel>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Margin="0,12,0,0" Padding="24,16">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=CategoryList}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <!-- Категорії — фільтр знахідок: клік показує, що саме знизило оцінку категорії -->
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Margin="-10,0,-10,0"
                     ToolTip="Натисніть на категорію, щоб побачити, що вплинуло на її оцінку">
              <!-- Без власного ScrollViewer: інакше він перехоплює коліщатко миші сторінки -->
              <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="0,1,8,1"/><Setter Property="Cursor" Value="Hand"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3,0,3">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="#8E8E93" VerticalAlignment="Center" Margin="6,0,0,0"/>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding Color}"/>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding Number}" Maximum="100" Height="7" Margin="0,7,0,0" Foreground="{Binding Color}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <StackPanel Grid.Row="2">
            <!-- Результат застарів: після сканування були зміни або минуло понад добу -->
            <Border x:Name="StaleBanner" Background="#FFF4E5" CornerRadius="12" Padding="16,10" Margin="0,4,0,8" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="BtnStaleRescan" DockPanel.Dock="Right" Content="Сканувати знову" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StaleText" Foreground="#B25000" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"/>
              </DockPanel>
            </Border>
            <DockPanel>
              <Button x:Name="BtnScoreHelp" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Як рахується оцінка?" VerticalAlignment="Bottom" Margin="16,0,4,7"/>
              <Button x:Name="BtnMoreFindings" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Поради" VerticalAlignment="Bottom" Margin="16,0,4,7" Visibility="Collapsed"/>
              <Button x:Name="BtnHiddenFindings" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Приховані" VerticalAlignment="Bottom" Margin="16,0,4,7" Visibility="Collapsed" ToolTip="Знахідки, які ви прийняли й приховали: вони не показуються й не знижують оцінку"/>
              <Button x:Name="BtnAllFindings" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Показати всі знахідки" VerticalAlignment="Bottom" Margin="0,0,4,7" Visibility="Collapsed"/>
              <TextBlock x:Name="FindingsTitle" Style="{StaticResource Section}" Text="Що знайдено"/>
            </DockPanel>
            <TextBlock x:Name="ScoreExplain" Style="{StaticResource RowNote}" Margin="16,0,16,8" Visibility="Collapsed"/>
          </StackPanel>
          <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,0,0,12" MinHeight="240">
            <Grid>
              <ListBox x:Name="FindingsList" HorizontalContentAlignment="Stretch">
                <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate></ListBox.Template>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{Binding Color}" VerticalAlignment="Top" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Badge}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <!-- Скільки балів знахідка зняла з оцінки категорії -->
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="12,2,4,0"/>
                      <!-- Дія знахідки: «Виправити» (Debora зробить сама) або «Як виправити» (покрокова інструкція) -->
                      <Button x:Name="BtnFindingFix" DockPanel.Dock="Right" Content="{Binding FixLabel}" Tag="{Binding}" ToolTip="{Binding FixTip}"
                              Padding="13,5" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Top">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                            <Style.Triggers><DataTrigger Binding="{Binding FixLabel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding FixLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <!-- «Приховати» (прийнято, не показувати до нового випадку) / «Показати знову» у списку прихованого -->
                      <Button x:Name="BtnFindingHide" Content="{Binding HideLabel}" Tag="{Binding}" ToolTip="{Binding HideTip}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="14,6,0,0">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                            <Setter Property="Foreground" Value="#6E6E73"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HideLabel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HideLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button x:Name="BtnFindingGuide" DockPanel.Dock="Right" Content="{Binding GuideLabel}" Tag="{Binding}" ToolTip="Покрокова інструкція: що і де зробити"
                              Padding="13,5" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Top">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                            <Style.Triggers><DataTrigger Binding="{Binding GuideLabel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding GuideLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Note}" Foreground="#6E6E73" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Optional}" Foreground="#6E6E73" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding Links}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><Button Style="{StaticResource LinkButton}" Content="{Binding Label}" Tag="{Binding Url}" ToolTip="{Binding Url}"/></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Перелік файлів і папок знахідки: підказка в згорнутому рядку, перелік — після кліку (рядок вибрано) -->
                        <TextBlock Text="{Binding Hint}" Foreground="#007AFF" FontSize="13" Margin="0,4,0,0" Cursor="Hand">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding Items}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                          <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding Items}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ItemsControl.Style>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <DockPanel Margin="0,2,0,2">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Відкрити в Провіднику" Tag="{Binding Tag}" ToolTip="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#6E6E73" FontSize="13" MinWidth="64" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Foreground="#6E6E73" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" VerticalAlignment="Center"/>
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="440">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=FindingsList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="38" Foreground="#C7C7CC" HorizontalAlignment="Center"/>
                <TextBlock Text="Тут з'являться знахідки" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                <TextBlock Text="Натисніть «Лише сканувати», щоб побачити стан ПК без змін, або «Сканувати й виправити все»." Foreground="#6E6E73" TextWrapping="Wrap" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        </ScrollViewer>
      </TabItem>


      <!-- ================= Налаштування (твіки) ================= -->
      <TabItem Uid="settings" Header="Налаштування" Tag="&#xE713;" Background="#8E8E93">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <ComboBox x:Name="PresetBox" Width="270" Margin="0,0,8,6"/>
            <Button x:Name="BtnSelectPreset" Content="Вибрати профіль" Margin="0,0,8,6"/>
            <Button x:Name="BtnSelectNone" Content="Зняти все" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="TweaksSummary" Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12" Text="Стан налаштувань завантажується…"/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="TweakGrid">
              <DataGrid.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#6E6E73" Margin="12,14,0,6"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </DataGrid.GroupStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Налаштування" Width="3*" MinWidth="380">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,4,8,4">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#6E6E73" FontSize="13" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ризик" Width="120">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Зараз" Binding="{Binding Status}" Width="150" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Примітка" Binding="{Binding Note}" Width="2*" MinWidth="180" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#6E6E73"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <!-- Нижня смуга дій — як у «Програмах» і «Видаленні» -->
          <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="BtnApply" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Застосувати вибране" Margin="0" MinWidth="220"/>
            <Button x:Name="BtnPreview" DockPanel.Dock="Right" Content="Що зміниться"/>
            <TextBlock x:Name="TweaksSelText" VerticalAlignment="Center" Foreground="#6E6E73" Margin="4,0,12,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Деблоат ================= -->
      <TabItem Uid="debloat" Header="Деблоат" Tag="&#xEA99;" Background="#FF2D55">
        <!-- Одна таблиця з двома розділами (групування за Badge): одна прокрутка на всю вкладку -->
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnDebloatRecommended" Content="Вибрати рекомендоване" IsEnabled="False" Margin="0,0,8,6"/>
            <Button x:Name="BtnDebloatNone" Content="Зняти все" IsEnabled="False" Margin="0,0,8,6"/>
            <Button x:Name="BtnDebloatRefresh" Content="Оновити" Margin="0,0,8,6"/>
            <Grid Width="300" Margin="8,0,8,6">
              <TextBox x:Name="DebloatSearch" Padding="10,6"/>
              <TextBlock x:Name="DebloatSearchHint" Text="Пошук…" Foreground="#8E8E93" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </WrapPanel>
          <TextBlock x:Name="DebloatSummary" Grid.Row="1" Style="{StaticResource Intro}" Margin="4,6,0,12"
                     Text="Прибирання Windows від нав'язаних застосунків, реклами, Copilot і стеження. Перед змінами створюється точка відновлення; кожну зміну можна повернути на вкладці «Журнал змін»."/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="DebloatGrid">
              <DataGrid.GroupStyle>
                <GroupStyle>
                  <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#6E6E73" Margin="12,14,0,6"/>
                    </DataTemplate>
                  </GroupStyle.HeaderTemplate>
                </GroupStyle>
              </DataGrid.GroupStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Що прибрати" Width="*" MinWidth="420">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,4,8,4" ToolTip="{Binding Group}">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#6E6E73" FontSize="13" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Рекомендація" Width="170">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Зараз" Binding="{Binding Status}" Width="170" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="BtnDebloatRun" ToolTipService.ShowOnDisabled="True" ToolTip="Позначте пункти в списку" Style="{StaticResource Primary}" Content="Застосувати вибране" IsEnabled="False" DockPanel.Dock="Right" Margin="0" MinWidth="220"/>
            <TextBlock x:Name="DebloatSelText" VerticalAlignment="Center" Foreground="#6E6E73" Margin="4,0,12,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Налаштування з нуля ================= -->
      <TabItem Uid="setup" Header="З нуля" Tag="&#xE9F5;" Background="#32ADE6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,24" MaxWidth="1240" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource Intro}" Margin="4,0,0,4"
                       Text="Щойно встановлена Windows — драйвери, деблоат, налаштування, програми й оновлення за один прохід. Позначте кроки й натисніть «Почати налаштування»."/>
            <TextBlock Style="{StaticResource Section}" Text="Кроки"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox x:Name="ChkSuDrivers" Content="Драйвери з інтернету (каталог Microsoft і Windows Update)" Margin="0,3"/>
                <CheckBox x:Name="ChkSuDebloat" Content="Деблоат Windows: нав'язані застосунки, реклама, Copilot, телеметрія (рекомендоване)" Margin="0,3"/>
                <DockPanel Margin="0,3">
                  <ComboBox x:Name="SuPresetBox" DockPanel.Dock="Right" Width="360" Margin="12,0,0,0"/>
                  <CheckBox x:Name="ChkSuTweaks" Content="Профіль налаштувань: швидкодія, Провідник, захист" VerticalAlignment="Center"/>
                </DockPanel>
                <CheckBox x:Name="ChkSuApps" Content="Програми (набори й окремі — нижче)" Margin="0,3"/>
                <CheckBox x:Name="ChkSuWindows" Content="Оновлення Windows (може тривати довго)" Margin="0,3"/>
                <CheckBox x:Name="ChkSuScanFix" Content="Сканування й автоматичне виправлення знайденого" Margin="0,3"/>
                <CheckBox x:Name="ChkSuReboot" Content="Перезавантажити ПК наприкінці, якщо потрібно" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Section}" Text="Програми"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <ItemsControl x:Name="SuBundles">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,3">
                        <StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource RowNote}" Margin="0"/></StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource RowNote}" Margin="0,12,0,4" Text="Окремі програми — кнопкою «Вибрати програми…» (або ID з каталогу через кому, наприклад Google.Chrome, 7zip.7zip)."/>
                <DockPanel>
                  <Button x:Name="BtnSuAddSelected" DockPanel.Dock="Right" Content="Додати вибрані на вкладці «Програми»" Margin="8,0,0,0"/>
                  <Button x:Name="BtnSuPickApps" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Вибрати програми…" Margin="8,0,0,0"/>
                  <TextBox x:Name="SuAppsBox"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Section}" Text="План"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <TextBox x:Name="SuNameBox" DockPanel.Dock="Right" Width="380"/>
                  <TextBlock Text="Назва плану" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <StackPanel Margin="16,12,14,14">
                  <WrapPanel>
                    <Button x:Name="BtnSuRun" Style="{StaticResource Primary}" Content="Почати налаштування"/>
                    <Button x:Name="BtnSuPlan" Content="Що буде зроблено"/>
                    <Button x:Name="BtnSuSave" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="16,0,0,0" Content="Зберегти план у файл…"/>
                    <Button x:Name="BtnSuLoad" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="16,0,0,0" Content="Завантажити план з файлу…"/>
                  </WrapPanel>
                  <TextBlock x:Name="SuState" Style="{StaticResource RowNote}" Margin="0,10,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Драйвери ================= -->
      <TabItem Uid="drivers" Header="Драйвери" Tag="&#xE772;" Background="#FF9500">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,20">
            <WrapPanel>
              <Button x:Name="BtnDriverScan" Style="{StaticResource Primary}" Content="Перевірити драйвери" Margin="0,0,8,6"/>
              <Button x:Name="BtnOemPage" ToolTipService.ShowOnDisabled="True" ToolTip="Активна, коли виробника ПК знайдено в базі" Content="Сторінка драйверів виробника" IsEnabled="False" Margin="0,0,8,6"/>
              <Button x:Name="BtnOemTool" Content="Утиліта виробника" Visibility="Collapsed" Margin="0,0,8,6" ToolTip="Встановить і запустить фірмову утиліту виробника ПК: драйвери й BIOS саме для вашої моделі"/>
            </WrapPanel>
            <TextBlock x:Name="OemText" Style="{StaticResource Intro}" Margin="4,6,0,0"/>

            <TextBlock Style="{StaticResource Section}" Text="Пристрої без драйвера або з помилкою"/>
            <Border Style="{StaticResource Panel}">
              <ListBox x:Name="DriverProblemsList" ItemTemplate="{StaticResource ItemTemplate}" MinHeight="44" MaxHeight="320"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Нові драйвери з інтернету"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Intro}" Margin="0,0,0,10"
                           Text="Debora шукає драйвери для пристроїв без драйвера і новіші версії для решти в офіційному каталозі Microsoft (там драйвери від Intel, AMD, NVIDIA, Realtek та інших) і серед рекомендацій Windows Update. Завантаження перевіряються за контрольною сумою, попередні драйвери зберігаються для відкату."/>
                <WrapPanel>
                  <Button x:Name="BtnDriverOnline" Style="{StaticResource Primary}" Content="Знайти нові драйвери" Margin="0,0,8,6"/>
                  <Button x:Name="BtnDriverOnlineInstall" ToolTipService.ShowOnDisabled="True" ToolTip="Спершу натисніть «Знайти нові драйвери» й відмітьте потрібні" Content="Завантажити й встановити вибрані" IsEnabled="False" Margin="0,0,8,6"/>
                </WrapPanel>
                <DataGrid x:Name="DriverOnlineGrid" Margin="-6,6,-6,0" MinHeight="40" MaxHeight="320">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="54">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Пристрій" Binding="{Binding Title}" Width="2*" MinWidth="200" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Id}"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Що робити" Width="150">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Зараз → нова версія" Binding="{Binding Detail}" Width="2*" MinWidth="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Розмір і джерело" Binding="{Binding Note}" Width="190" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#6E6E73"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Expander x:Name="DevicesExpander" Header="Усі пристрої й драйвери" Margin="0,18,0,0" FontWeight="SemiBold">
              <ContentControl FontWeight="Normal">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="BtnDevicesExport" DockPanel.Dock="Right" Content="Зберегти список (CSV)" IsEnabled="False" Margin="8,0,0,0"/>
                  <ComboBox x:Name="DeviceView" DockPanel.Dock="Right" Width="230" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Tag="hardware" Content="Обладнання"/>
                    <ComboBoxItem Tag="all" Content="Усі пристрої (з віртуальними)"/>
                    <ComboBoxItem Tag="thirdparty" Content="Драйвери виробників"/>
                    <ComboBoxItem Tag="old" Content="Драйвери старші за 3 роки"/>
                    <ComboBoxItem Tag="problems" Content="З проблемами або вимкнені"/>
                  </ComboBox>
                  <Grid>
                    <TextBox x:Name="DeviceSearch" Style="{StaticResource Search}" VerticalAlignment="Stretch"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#6E6E73" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="DeviceSearchHint" Text="Пошук: назва, виробник, версія, INF або ID обладнання" Foreground="#8E8E93" FontSize="16" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  </Grid>
                </DockPanel>
                <TextBlock x:Name="DevicesSummary" Style="{StaticResource Intro}" Margin="0,10,0,6" Text="Натисніть «Перевірити драйвери», щоб побачити всі пристрої комп'ютера з версіями й датами драйверів. Наведіть мишку на рядок — ID обладнання, INF-файл і виробник."/>
                <DataGrid x:Name="DriverInstalledGrid" Margin="-6,0,-6,0" MinHeight="44" MaxHeight="560">
                  <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Id}"/></Style>
                  </DataGrid.RowStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Group}" Width="150" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#6E6E73"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Пристрій" Binding="{Binding Title}" Width="2*" MinWidth="200" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Версія" Binding="{Binding Status}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Detail}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Постачальник" Binding="{Binding Note}" Width="*" MinWidth="160" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Стан" Width="130">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

              </ContentControl>
            </Expander>
            <TextBlock Style="{StaticResource Section}" Text="Драйвери з папки"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Intro}" Margin="0,0,0,10"
                           Text="Завантажте драйвери з сайту виробника в папку (архіви .zip теж можна). Програма знайде ті, що підходять до цього ПК, пропустить актуальні й поставить у правильному порядку, зберігши попередні для відкату."/>
                <DockPanel>
                  <Button x:Name="BtnFindDrivers" DockPanel.Dock="Right" Content="Знайти драйвери в папці" Margin="8,0,0,0"/>
                  <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="Огляд…" Margin="8,0,0,0"/>
                  <TextBox x:Name="DriverFolder" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="DriverPackageGrid" Margin="-6,10,-6,0" MinHeight="44" MaxHeight="300">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="54">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Пристрій" Binding="{Binding Title}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Що робити" Width="150">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Зараз → у папці" Binding="{Binding Detail}" Width="2*" MinWidth="220" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Файл" Binding="{Binding Note}" Width="*" MinWidth="160" IsReadOnly="True"/>
                  </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="BtnInstallDrivers" ToolTipService.ShowOnDisabled="True" ToolTip="Спершу знайдіть драйвери в папці й відмітьте потрібні" Style="{StaticResource Primary}" Content="Встановити вибрані драйвери" IsEnabled="False"/>
                </WrapPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Програми ================= -->
      <TabItem Uid="apps" Header="Програми" Tag="&#xE71D;" Background="#5856D6">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Grid>
              <TextBox x:Name="AppSearch" Style="{StaticResource Search}" VerticalAlignment="Stretch" Height="40" FontSize="14"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#6E6E73" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="AppSearchHint" Text="Пошук: назва програми або для чого вона (наприклад «pdf», «відео», «vpn»)" Foreground="#8E8E93" FontSize="14" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <!-- Компактно: набори одним рядком дрібними «пігулками», більше місця каталогу -->
            <DockPanel Margin="0,8,0,0">
              <TextBlock DockPanel.Dock="Left" Text="Набори:" Foreground="#6E6E73" FontSize="13" Margin="4,5,8,0" VerticalAlignment="Top"/>
              <WrapPanel x:Name="AppBundles"/>
            </DockPanel>
            <TextBlock x:Name="AppsSummary" Style="{StaticResource Intro}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="4,2,0,0"
                       Text="Позначте програми — клацніть по картці — і натисніть «Встановити». Встановлення через winget: офіційні інсталятори, без реклами й «довантажувачів»."/>
            <Button x:Name="BtnWingetStore" Style="{StaticResource LinkButton}" Content="Встановити winget («Інсталятор застосунків») з Microsoft Store" Visibility="Collapsed" HorizontalAlignment="Left" Margin="4,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Margin="0,0,14,10">
              <ListBox x:Name="AppCategoryList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12,5"/></Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#6E6E73" Margin="8,0,0,0"/>
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="AppCards">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Top"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- Компактна картка: клік по всій картці — вибір; вибрану видно за рамкою й позначкою ✓ (без окремого квадратика) -->
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" Margin="0,0,10,10" ToolTip="{Binding Id}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                      <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                          <Border x:Name="Bd" CornerRadius="12" Background="White" BorderBrush="Transparent" BorderThickness="1.5" Padding="12,10">
                            <DockPanel>
                              <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border CornerRadius="10" Background="#E5E5EA">
                                  <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold" Foreground="#6E6E73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border CornerRadius="10" Background="White">
                                  <Border.Style>
                                    <Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                                  </Border.Style>
                                  <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                              </Grid>
                              <Border x:Name="Mark" DockPanel.Dock="Right" Width="20" Height="20" CornerRadius="10" Background="#007AFF" VerticalAlignment="Top" Margin="8,0,0,0" Visibility="Hidden">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Note}" Foreground="#6E6E73" FontSize="13" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontSize="12.5" Margin="0,3,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </DockPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#D1D1D6"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#007AFF"/><Setter TargetName="Bd" Property="Background" Value="#EAF2FF"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </CheckBox.Template>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,4,0,12" Height="56">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnAppsClear" Content="Зняти вибір"/>
              <Button x:Name="BtnAppsRefresh" Content="Перевірити встановлені"/>
              <Button x:Name="BtnAppsUpgrade" Content="Оновити всі програми"/>
              <Button x:Name="BtnAppsInstall" ToolTipService.ShowOnDisabled="True" ToolTip="Клацніть по картках програм, щоб вибрати" Style="{StaticResource Primary}" Content="Встановити вибрані" IsEnabled="False" Margin="0" MinWidth="230" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="AppSelectedText" VerticalAlignment="Center" Text="Нічого не вибрано" Foreground="#6E6E73" Margin="4,0,12,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Видалення програм ================= -->
      <TabItem Uid="uninstall" Header="Видалення" Tag="&#xE74D;" Background="#FF3B30">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <TextBox x:Name="UninstSearch" Style="{StaticResource Search}" VerticalAlignment="Stretch"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="#6E6E73" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="UninstSearchHint" Text="Пошук серед встановлених програм" Foreground="#8E8E93" FontSize="16" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <DockPanel Grid.Row="1" Margin="4,12,0,12">
            <CheckBox x:Name="ChkUninstBloat" DockPanel.Dock="Right" Content="Лише рекомендовані до видалення" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock x:Name="UninstSummary" Style="{StaticResource Intro}" VerticalAlignment="Center"
                       Text="Позначте програми, які більше не потрібні. Більшість видаляється тихо; для решти відкриється звичайний деінсталятор. Вбудовані застосунки Windows (Xbox, Кліпчамп, Copilot…) — на вкладці «Деблоат»."/>
          </DockPanel>
          <Border Grid.Row="2" Style="{StaticResource Panel}">
            <DataGrid x:Name="UninstGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="54">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Програма" Binding="{Binding Title}" Width="3*" MinWidth="220" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Видавець" Binding="{Binding Group}" Width="2*" MinWidth="120" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Розмір" Binding="{Binding Note}" SortMemberPath="Number" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Встановлено" Binding="{Binding Kind}" Width="130" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Примітка" Width="3*" MinWidth="200">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <DockPanel Grid.Row="3" Margin="0,10,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="BtnUninstRefresh" Content="Оновити список"/>
              <Button x:Name="BtnUninstall" ToolTipService.ShowOnDisabled="True" ToolTip="Позначте програми в списку" Style="{StaticResource Primary}" Content="Видалити вибрані" IsEnabled="False" Margin="0" MinWidth="200"/>
            </StackPanel>
            <TextBlock x:Name="UninstSelectedText" VerticalAlignment="Center" Foreground="#6E6E73" Margin="4,0,12,0" Text="Нічого не вибрано" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Автозавантаження ================= -->
      <TabItem Uid="startup" Header="Автозавантаження" Tag="&#xE945;" Background="#FF9F0A">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnStartupRecommended" ToolTipService.ShowOnDisabled="True" Content="Вимкнути рекомендовані" Margin="0,0,8,6" ToolTip="Зняти галочки з програм, яким не потрібно стартувати разом із Windows (лаунчери ігор, «помічники», реклама виробника), і застосувати"/>
            <Button x:Name="BtnStartupRefresh" Content="Оновити список" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock x:Name="StartupSummary" Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12"
                     Text="Зніміть галочку з програм, яким не потрібно стартувати разом із Windows, і натисніть «Застосувати зміни». Програми не видаляються — лише не запускаються самі; усе відкочується."/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="StartupGrid">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Запускати" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Програма" Binding="{Binding Title}" Width="2*" MinWidth="220" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Видавець" Binding="{Binding Group}" Width="170" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Звідки" Binding="{Binding Note}" Width="190" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Примітка" Width="2*" MinWidth="300">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="BtnStartupApply" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Застосувати зміни" Margin="0" MinWidth="220"/>
            <TextBlock x:Name="StartupSelText" VerticalAlignment="Center" Foreground="#6E6E73" Margin="4,0,12,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ================= Обслуговування ================= -->
      <TabItem Uid="maintenance" Header="Обслуговування" Tag="&#xE90F;" Background="#30B0C7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,24" MaxWidth="1240" HorizontalAlignment="Stretch">

            <TextBlock Style="{StaticResource Section}" Margin="16,0,0,7" Text="Стан комп'ютера"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <StackPanel Margin="16,12,14,12">
                  <DockPanel>
                    <Button x:Name="BtnDisksRefresh" DockPanel.Dock="Right" Content="Перевірити" VerticalAlignment="Center" Margin="0"/>
                    <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Стан дисків"/>
                      <TextBlock x:Name="DisksState" Style="{StaticResource RowNote}" Text="Температура, знос SSD, години роботи й помилки (SMART) для кожного диска."/></StackPanel>
                  </DockPanel>
                  <ItemsControl x:Name="DisksList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,10,0,0">
                          <Ellipse DockPanel.Dock="Left" Width="11" Height="11" Fill="{Binding Color}" VerticalAlignment="Top" Margin="2,6,14,0"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource Optional}" Foreground="{Binding Color}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource RowNote}"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- Стан батареї: показується лише на ноутбуках (Gui.ps1 вмикає Visibility) -->
                <Border x:Name="BatterySep" Style="{StaticResource Sep}" Visibility="Collapsed"/>
                <StackPanel x:Name="BatteryPanel" Margin="16,12,14,12" Visibility="Collapsed">
                  <DockPanel>
                    <TextBlock x:Name="BatteryStatus" DockPanel.Dock="Right" FontWeight="SemiBold" VerticalAlignment="Top" Margin="12,0,0,0"/>
                    <Ellipse x:Name="BatteryDot" DockPanel.Dock="Left" Width="11" Height="11" Fill="#6E6E73" VerticalAlignment="Top" Margin="2,6,14,0"/>
                    <StackPanel>
                      <TextBlock Style="{StaticResource RowTitle}" Text="Стан батареї"/>
                      <TextBlock x:Name="BatteryDetail" Style="{StaticResource RowNote}" Text="Ємність, історія зносу й час роботи від батареї."/>
                    </StackPanel>
                  </DockPanel>
                  <Grid Margin="27,10,0,0" HorizontalAlignment="Left">
                    <Border Width="320" Height="48" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1"/>
                    <Path x:Name="BatterySpark" Stroke="#30B0C7" StrokeThickness="2" StrokeLineJoin="Round" Width="320" Height="48"/>
                  </Grid>
                  <TextBlock x:Name="BatterySparkNote" Style="{StaticResource RowNote}" Margin="27,2,0,0"/>
                  <TextBlock x:Name="BatteryAdvice" Style="{StaticResource RowNote}" Foreground="#B25000" Margin="27,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnRestorePoint" DockPanel.Dock="Right" Content="Створити" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Точка відновлення"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Знімок системи, до якого можна повернутися, якщо після змін щось піде не так."/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Очищення й ремонт"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnCleanNow" DockPanel.Dock="Right" Content="Очистити" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Очищення диска"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Тимчасові файли, кеш оновлень Windows, дампи збоїв і звіти про помилки, залишки інсталяторів драйверів. Кошик не чіпається."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnRepair" DockPanel.Dock="Right" Content="Перевірити й відновити" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Відновлення системних файлів"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="DISM і SFC — коли Windows поводиться дивно, оновлення не ставляться або вбудовані програми не відкриваються. Триває 10–40 хвилин, потрібен інтернет."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnMemoryTest" DockPanel.Dock="Right" Content="Запланувати" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Перевірка оперативної пам'яті"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли бувають сині екрани з різними кодами або падають різні програми. Перевірка запуститься під час наступного перезавантаження (10–20 хвилин), результат покаже сканування."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnSearchReset" DockPanel.Dock="Right" Content="Перебудувати" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Пошуковий індекс Windows"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли пошук у «Пуску» не знаходить файли чи програми або індекс займає гігабайти. Індекс створиться заново у фоні за кілька годин."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnIconCache" DockPanel.Dock="Right" Content="Скинути кеш" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Кеш значків і ескізів"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли замість значків білі аркуші, значки переплутані або ескізи фото застарілі. Провідник перезапуститься (відкриті вікна папок закриються)."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnNetReset" DockPanel.Dock="Right" Content="Скинути мережу" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Скидання мережі"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли Wi-Fi підключено, а сайти не відкриваються: очищення кешу DNS, скидання Winsock і TCP/IP. Потрібне перезавантаження."/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnWuReset" DockPanel.Dock="Right" Content="Скинути Windows Update" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Скидання Windows Update"/>
                    <TextBlock Style="{StaticResource RowNote}" Text="Коли оновлення зависли або постійно падають з помилкою: зупинка служб, новий кеш оновлень, запуск служб."/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Оновлення Windows"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="PauseDays" Width="130" Margin="0,0,8,0" SelectedIndex="0">
                      <ComboBoxItem Content="7 днів"/><ComboBoxItem Content="14 днів"/><ComboBoxItem Content="21 день"/><ComboBoxItem Content="35 днів"/>
                    </ComboBox>
                    <Button x:Name="BtnPause" Content="Призупинити"/>
                    <Button x:Name="BtnResume" Content="Відновити" Margin="0"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Пауза оновлень"/>
                    <TextBlock x:Name="PauseState" Style="{StaticResource RowNote}"/></StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnWuDrivers" DockPanel.Dock="Right" Content="Вимкнути" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Драйвери з Windows Update"/>
                    <TextBlock x:Name="WuDriversState" Style="{StaticResource RowNote}"/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Section}" Text="Автоматичне обслуговування"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource RowNote}" Margin="0,0,0,10"
                           Text="Раз на тиждень Debora сама створить точку відновлення й виконає вибране, потім просканує ПК і покаже сповіщення з підсумком. Працює, коли ви увійшли в Windows; пропущений запуск виконається при наступному вході."/>
                <CheckBox x:Name="ChkMtCleanup" Content="Очищення диска (тимчасові файли, кеш оновлень, залишки інсталяторів)" Margin="0,3"/>
                <CheckBox x:Name="ChkMtDefender" Content="Антивірусні бази Захисника" Margin="0,3"/>
                <CheckBox x:Name="ChkMtApps" Content="Оновлення програм (winget)" Margin="0,3"/>
                <CheckBox x:Name="ChkMtDrivers" Content="Новіші драйвери з каталогу Microsoft (лише рекомендовані)" Margin="0,3"/>
                <CheckBox x:Name="ChkMtWindows" Content="Оновлення Windows (зазвичай Windows ставить їх сама)" Margin="0,3"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <TextBlock Text="Коли" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <ComboBox x:Name="MtDay" Width="170" Margin="0,0,8,0"/>
                  <TextBox x:Name="MtTime" Width="78" Text="12:00" VerticalContentAlignment="Center"/>
                </StackPanel>
                <WrapPanel Margin="0,14,0,0">
                  <Button x:Name="BtnScheduleOn" Style="{StaticResource Primary}" Content="Увімкнути розклад"/>
                  <Button x:Name="BtnScheduleOff" Content="Вимкнути"/>
                  <Button x:Name="BtnMaintainNow" Content="Виконати зараз"/>
                </WrapPanel>
                <TextBlock x:Name="ScheduleState" Style="{StaticResource RowNote}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Перевстановлення ================= -->
      <TabItem Uid="reinstall" Header="Перевстановлення" Tag="&#xE88E;" Background="#AF52DE">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,24" MaxWidth="1240" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource Intro}" Margin="4,0,0,4"
                       Text="Чиста Windows без зайвих запитань і з драйверами цього ПК: вставте флешку з Windows (Media Creation Tool або Rufus) і натисніть «Підготувати флешку»."/>
            <TextBlock Style="{StaticResource Section}" Text="Інсталяційна флешка"/>
            <Border Style="{StaticResource Group}">
              <StackPanel>
                <DockPanel Style="{StaticResource Row}">
                  <Button x:Name="BtnUsbRefresh" DockPanel.Dock="Right" Content="Оновити список" Margin="8,0,0,0"/>
                  <ComboBox x:Name="UsbBox"/>
                </DockPanel>
            <WrapPanel Margin="0,8,0,0">
              <TextBlock Text="Немає флешки з Windows? Завантажте:" Foreground="#6E6E73" Margin="0,5,10,0"/>
              <Button Style="{StaticResource LinkButton}" Content="Windows 11 (Microsoft)" Tag="https://www.microsoft.com/software-download/windows11"/>
              <Button Style="{StaticResource LinkButton}" Content="Windows 10 (Microsoft)" Tag="https://www.microsoft.com/software-download/windows10"/>
              <Button Style="{StaticResource LinkButton}" Content="Rufus" Tag="https://rufus.ie"/>
            </WrapPanel>
                <TextBlock x:Name="UsbInfo" Style="{StaticResource RowNote}" Margin="16,-4,16,10"/>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <TextBox x:Name="UserNameBox" DockPanel.Dock="Right" Width="380" Text="User"/>
                  <TextBlock Text="Ім'я облікового запису" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <PasswordBox x:Name="AccountPasswordBox" DockPanel.Dock="Right" Width="380"/>
                  <TextBlock Text="Пароль (можна лишити порожнім)" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <DockPanel Style="{StaticResource Row}">
                  <ComboBox x:Name="EditionBox" DockPanel.Dock="Right" Width="380" SelectedIndex="0">
                    <ComboBoxItem Content="Вибрати під час встановлення"/>
                    <ComboBoxItem Content="Home (Домашня)"/>
                    <ComboBoxItem Content="Pro"/>
                  </ComboBox>
                  <TextBlock Text="Редакція Windows" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Sep}"/>
                <StackPanel Margin="16,12,14,14">
                  <CheckBox x:Name="ChkUsbDrivers" IsChecked="True" Content="Додати драйвери цього ПК — Windows поставить їх під час встановлення"/>
                  <CheckBox x:Name="ChkUsbBypass" IsChecked="True" Margin="0,8,0,0" Content="Дозволити Windows 11 на старому ПК (без TPM 2.0, Secure Boot, з непідтримуваним процесором)"/>
                  <CheckBox x:Name="ChkUsbPost" IsChecked="True" Margin="0,8,0,0" Content="Після першого входу: рекомендовані налаштування Debora і драйвери з інтернету"/>
                  <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="BtnPrepareUsb" Style="{StaticResource Primary}" Content="Підготувати флешку"/>
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Section}" Text="Резервна копія"/>
            <Border Style="{StaticResource Group}">
              <DockPanel Style="{StaticResource Row}">
                <Button x:Name="BtnExportDrivers" DockPanel.Dock="Right" Content="Зберегти в папку…" VerticalAlignment="Center" Margin="0"/>
                <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Драйвери цього ПК"/>
                  <TextBlock Style="{StaticResource RowNote}" Text="Усі сторонні драйвери в одну папку. Після перевстановлення поставте їх на вкладці «Драйвери» → «Драйвери з папки»."/></StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= Журнал ================= -->
      <TabItem Uid="history" Header="Журнал змін" Tag="&#xE81C;" Background="#A2845E">
        <Grid Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel>
            <Button x:Name="BtnUndo" Style="{StaticResource Primary}" Content="Відкотити вибрані зміни" Margin="0,0,8,6"/>
            <Button x:Name="BtnRefreshSessions" Content="Оновити" Margin="0,0,8,6"/>
            <Button x:Name="BtnSystemRestore" Content="Відновлення системи Windows" Margin="0,0,8,6"/>
            <Button x:Name="BtnDiagnostics" Content="Зібрати діагностику" Margin="0,0,8,6" ToolTip="Один zip з відомостями про систему, драйвери, помилки й журнал змін — щоб розібратися з проблемою"/>
          </WrapPanel>
          <TextBlock Grid.Row="1" Style="{StaticResource Intro}" Margin="4,8,0,12"
                     Text="Кожне застосування змін — окрема сесія. Відкат повертає саме те, що було до змін; значення, які після цього змінили ви або Windows, не перезаписуються."/>
          <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DataGrid x:Name="SessionGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Коли" Binding="{Binding Title}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Що застосовано" Binding="{Binding Detail}" Width="*" MinWidth="360" IsReadOnly="True"/>
                <DataGridTextColumn Header="Змін" Binding="{Binding Number}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Стан" Binding="{Binding Status}" Width="190" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <!-- Що саме змінила вибрана сесія і що не вдалося -->
          <Border x:Name="SessionDetailPanel" Grid.Row="3" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="16,12" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="SessionDetailTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
              <TextBox x:Name="SessionDetailBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" FontSize="13.5" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ================= Параметри Debora ================= -->
      <TabItem Uid="prefs" Header="Параметри" Tag="&#xE771;" Background="#8E8E93">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,0,20,24" MaxWidth="1240" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource Section}" Text="Вигляд і мова"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,6,0,6">
                  <ComboBox x:Name="PrefLanguage" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Мова інтерфейсу"/><TextBlock Style="{StaticResource RowNote}" Text="Автоматично — українська, якщо вона є в мовах Windows, інакше англійська." TextWrapping="Wrap"/></StackPanel>
                </DockPanel>
                <DockPanel Margin="0,6,0,6">
                  <ComboBox x:Name="PrefTheme" DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Тема"/><TextBlock Style="{StaticResource RowNote}" Text="Як у Windows — світла або темна за налаштуванням «Режим застосунків»." TextWrapping="Wrap"/></StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource RowNote}" Text="Зміна мови чи теми перевідкриває вікно." Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Section}" Text="Знахідки й підказки"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,6,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnPrefShowHidden" Content="Переглянути"/><Button x:Name="BtnPrefUnhideAll" Content="Повернути всі" Margin="0"/></StackPanel>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Приховані знахідки"/><TextBlock x:Name="PrefHiddenText" Style="{StaticResource RowNote}" Text="" TextWrapping="Wrap"/></StackPanel>
                </DockPanel>
                <DockPanel Margin="0,6,0,6">
                  <Button x:Name="BtnPrefWelcome" DockPanel.Dock="Right" Content="Показати" VerticalAlignment="Center" Margin="0"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Підказки «З чого почати»"/><TextBlock Style="{StaticResource RowNote}" Text="Вікно з порадами, яке з’являється при першому запуску." TextWrapping="Wrap"/></StackPanel>
                </DockPanel>
                <DockPanel Margin="0,6,0,6">
                  <CheckBox x:Name="PrefToasts" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                  <StackPanel Margin="0,0,16,0"><TextBlock Style="{StaticResource RowTitle}" Text="Сповіщення Windows"/><TextBlock Style="{StaticResource RowNote}" Text="Коли довга задача завершилась, а вікно Debora неактивне." TextWrapping="Wrap"/></StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Section}" Text="Дані й про програму"/>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="PrefAbout" Style="{StaticResource RowNote}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="BtnPrefData" Content="Папка даних" Margin="0,0,8,0"/>
                  <Button x:Name="BtnPrefLogs" Content="Журнали" Margin="0,0,8,0"/>
                  <Button x:Name="BtnPrefReports" Content="Звіти" Margin="0"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Щойно застосовано зміни: швидкий відкат (зникає за хвилину або з новою задачею) -->
    <Border x:Name="UndoBar" Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Margin="40,0,40,6" Padding="18,10" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="BtnUndoClose" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Закрити" Margin="14,0,0,0" VerticalAlignment="Center"/>
        <Button x:Name="BtnUndoLast" DockPanel.Dock="Right" Content="Відкотити" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="UndoText" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
    <!-- Зараз виконується: назва, крок, шкала, таймер, оцінка часу; черга наступних задач -->
    <Border x:Name="TaskPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Margin="40,0,40,6" Padding="18,12,18,12" Visibility="Collapsed">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock x:Name="TaskTimer" Text="0:00" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="BtnTaskStop" Content="Зупинити" Visibility="Collapsed" Margin="0,0,10,0" Padding="13,6" ToolTip="Зупинити після поточного кроку"/>
            <Button x:Name="BtnQueueToggle" Style="{StaticResource LinkButton}" Content="Черга" Visibility="Collapsed" VerticalAlignment="Center" Margin="0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="TaskTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TaskStage" Foreground="#6E6E73" FontSize="13.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="TaskBar" Height="6" Margin="0,8,0,0" IsIndeterminate="True"/>
            <TextBlock x:Name="TaskEta" Foreground="#6E6E73" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
        <StackPanel x:Name="QueuePanel" Visibility="Collapsed" Margin="0,10,0,0">
          <DockPanel>
            <Button x:Name="BtnQueueClear" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Очистити чергу" Margin="0"/>
            <TextBlock Text="Далі в черзі" FontWeight="SemiBold" FontSize="13.5"/>
          </DockPanel>
          <ItemsControl x:Name="QueueList" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3,0,3">
                  <Button x:Name="BtnQueueRemove" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Прибрати" Tag="{Binding Id}" Margin="12,0,0,0"/>
                  <Button x:Name="BtnQueueUp" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Вище" Tag="{Binding Id}" Margin="12,0,0,0"/>
                  <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Журнал виконання під вмістом -->
    <Expander x:Name="LogExpander" Grid.Row="2" Grid.Column="1" Header="Журнал виконання" Margin="40,0,40,8">
      <Border Style="{StaticResource Panel}" Margin="0,0,0,6">
        <TextBox x:Name="LogBox" Height="170" VerticalAlignment="Stretch" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/>
      </Border>
    </Expander>
  </Grid>
</Window>
