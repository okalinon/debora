  "bundles": {
    "comment": "Набори з tweaks.json, які на вкладці «Деблоат» показані поштучно (застосунки, служби, значок чату). На вкладці «Налаштування» їх не показуємо, щоб функції не дублювались; у профілях (presets) і CLI вони лишаються.",
    "ids": [ "apps.remove-bloat", "apps.remove-xbox", "apps.remove-teams-outlook" ]
  },
  "features": [
    { "id": "apps.disable-copilot", "section": "ai", "recommended": true },
    { "id": "privacy.activity-recall", "section": "ai", "recommended": true },
    { "id": "apps.block-autoinstall", "section": "ads", "recommended": true },
    { "id": "privacy.ads-tips", "section": "ads", "recommended": true },
    { "id": "ui.no-spotlight", "section": "ads", "recommended": true },
    { "id": "privacy.edge", "section": "ads", "recommended": true },
    { "id": "privacy.telemetry", "section": "privacy", "recommended": true },
    { "id": "privacy.feedback", "section": "privacy", "recommended": true },
    { "id": "privacy.app-launch-tracking", "section": "privacy", "recommended": true },
    { "id": "privacy.input-personalization", "section": "privacy", "recommended": true },
    { "id": "privacy.location", "section": "privacy", "recommended": false },
    { "id": "ui.start-no-recommended", "section": "shell", "recommended": true },
    { "id": "ui.search-local", "section": "shell", "recommended": true },
    { "id": "ui.widgets", "section": "shell", "recommended": true },
    { "id": "perf.edge-background", "section": "shell", "recommended": true },
    { "id": "apps.remove-onedrive", "section": "shell", "recommended": false },
    { "id": "perf.background-apps", "section": "shell", "recommended": false },
    { "id": "ui.classic-context-menu", "section": "context", "recommended": false }
  ],
  "items": [
    { "id": "ai-click-to-do", "section": "ai", "risk": "safe", "recommended": true,
      "name": { "uk": "Вимкнути Click to Do (дії ШІ над вмістом екрана)", "en": "Turn off Click to Do (AI actions on screen content)" },
      "description": { "uk": "Політика DisableClickToDo: Windows не аналізує вміст екрана, щоб пропонувати дії ШІ.", "en": "DisableClickToDo policy: Windows stops analysing the screen to suggest AI actions." },
      "actions": [
        { "type": "registry", "path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableClickToDo", "value": 1, "kind": "DWord" },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableClickToDo", "value": 1, "kind": "DWord" } ] },
    { "id": "ai-recall-enable", "section": "ai", "risk": "safe", "recommended": true,
      "name": { "uk": "Заборонити вмикати Recall (знімки екрана для ШІ)", "en": "Do not allow Recall (AI screen snapshots)" },
      "description": { "uk": "Політика AllowRecallEnablement = 0: Recall не можна ввімкнути, знімки екрана не зберігаються.", "en": "AllowRecallEnablement = 0: Recall cannot be turned on and no screen snapshots are kept." },
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "AllowRecallEnablement", "value": 0, "kind": "DWord" } ] },
    { "id": "ai-paint", "section": "ai", "risk": "safe", "recommended": true,
      "name": { "uk": "Paint без ШІ (Cocreator, генеративне заповнення, Image Creator)", "en": "Paint without AI (Cocreator, Generative fill, Image Creator)" },
      "description": { "uk": "Офіційні політики Paint: прибирають кнопки ШІ, які надсилають зображення в хмару Microsoft.", "en": "Official Paint policies that remove the AI buttons which send images to Microsoft's cloud." },
      "actions": [
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Paint", "name": "DisableCocreator", "value": 1, "kind": "DWord" },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Paint", "name": "DisableGenerativeFill", "value": 1, "kind": "DWord" },
        { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Paint", "name": "DisableImageCreator", "value": 1, "kind": "DWord" } ] },
    { "id": "ai-notepad", "section": "ai", "risk": "safe", "recommended": true,
      "name": { "uk": "Блокнот без ШІ (Copilot у Блокноті)", "en": "Notepad without AI (Copilot in Notepad)" },
      "description": { "uk": "Політика DisableAIFeatures для Блокнота: прибирає «Переписати» й інші функції Copilot.", "en": "Notepad DisableAIFeatures policy: removes Rewrite and other Copilot features." },
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\WindowsNotepad", "name": "DisableAIFeatures", "value": 1, "kind": "DWord" } ] },
    { "id": "ai-edge-copilot", "section": "ai", "risk": "safe", "recommended": true,
      "name": { "uk": "Edge без кнопки Copilot", "en": "Edge without the Copilot button" },
      "description": { "uk": "Політика Edge Microsoft365CopilotChatIconEnabled = 0: прибирає значок Copilot з панелі браузера.", "en": "Edge policy Microsoft365CopilotChatIconEnabled = 0 removes the Copilot icon from the toolbar." },
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge", "name": "Microsoft365CopilotChatIconEnabled", "value": 0, "kind": "DWord" } ] },
    { "id": "ai-recall-component", "section": "components", "risk": "safe", "recommended": true,
      "name": { "uk": "Вимкнути компонент Recall", "en": "Turn off the Recall component" },
      "description": { "uk": "Компонент Windows «Recall» (є лише на ПК з Copilot+). Вимикається через «Компоненти Windows».", "en": "The Recall Windows feature (Copilot+ PCs only), turned off via Windows features." },
      "actions": [ { "type": "feature", "name": "Recall", "state": "Disabled" } ] },

    { "id": "ads-welcome", "section": "ads", "risk": "safe", "recommended": true,
      "name": { "uk": "Без «Вітаємо в Windows» після оновлень", "en": "No Windows welcome experience after updates" },
      "description": { "uk": "Не показувати екран знайомства з новими функціями після кожного великого оновлення.", "en": "Do not show the new-features welcome screen after every big update." },
      "actions": [ { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-310093Enabled", "value": 0, "kind": "DWord" } ] },
    { "id": "ads-scoobe", "section": "ads", "risk": "safe", "recommended": true,
      "name": { "uk": "Без «Завершіть налаштування пристрою»", "en": "No “Finish setting up your device” prompts" },
      "description": { "uk": "Прибирає повноекранні нагадування підключити обліковий запис Microsoft, OneDrive і Microsoft 365.", "en": "Removes full-screen nags to connect a Microsoft account, OneDrive and Microsoft 365." },
      "actions": [ { "type": "registry", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement", "name": "ScoobeSystemSettingEnabled", "value": 0, "kind": "DWord" } ] },
    { "id": "ads-start-account", "section": "ads", "risk": "safe", "recommended": true,
      "name": { "uk": "Без сповіщень облікового запису в меню Пуск", "en": "No account notifications in Start" },
      "description": { "uk": "Прибирає з меню Пуск рекламу резервного копіювання, Microsoft 365 і «дії для облікового запису».", "en": "Removes backup, Microsoft 365 and account action promos from the Start menu." },
      "actions": [ { "type": "registry", "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_AccountNotifications", "value": 0, "kind": "DWord" } ] },
    { "id": "ads-edge-first-run", "section": "ads", "risk": "safe", "recommended": true,
      "name": { "uk": "Edge без майстра першого запуску", "en": "Edge without the first-run wizard" },
      "description": { "uk": "Політика HideFirstRunExperience: Edge не просить увійти, імпортувати дані й «персоналізувати».", "en": "HideFirstRunExperience policy: Edge stops asking to sign in, import data and personalise." },
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge", "name": "HideFirstRunExperience", "value": 1, "kind": "DWord" } ] },

    { "id": "privacy-online-speech", "section": "privacy", "risk": "safe", "recommended": true,
      "name": { "uk": "Вимкнути онлайн-розпізнавання мовлення", "en": "Turn off online speech recognition" },
      "description": { "uk": "Голос не надсилається в хмару Microsoft. Локальне розпізнавання й диктування в застосунках лишаються.", "en": "Voice is not sent to Microsoft's cloud. Local recognition and dictation in apps still work." },
      "actions": [ { "type": "registry", "path": "HKCU:\\Software\\Microsoft\\Speech_OneCore\\Settings\\OnlineSpeechPrivacy", "name": "HasAccepted", "value": 0, "kind": "DWord" } ] },
    { "id": "privacy-cloud-search", "section": "privacy", "risk": "safe", "recommended": true,
      "name": { "uk": "Пошук Windows без хмарного вмісту й історії", "en": "Windows search without cloud content and history" },
      "description": { "uk": "Пошук не показує вміст з облікових записів Microsoft і не зберігає історію пошуку на пристрої.", "en": "Search does not show content from Microsoft accounts and keeps no search history on the device." },
      "actions": [
        { "type": "registry", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings", "name": "IsMSACloudSearchEnabled", "value": 0, "kind": "DWord" },
        { "type": "registry", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings", "name": "IsAADCloudSearchEnabled", "value": 0, "kind": "DWord" },
        { "type": "registry", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\SearchSettings", "name": "IsDeviceSearchHistoryEnabled", "value": 0, "kind": "DWord" } ] },
    { "id": "privacy-app-diagnostics", "section": "privacy", "risk": "safe", "recommended": true,
      "name": { "uk": "Застосунки не читають діагностику інших застосунків", "en": "Apps cannot read other apps' diagnostics" },
      "description": { "uk": "Дозвіл «Діагностика застосунків» — заборонено.", "en": "App diagnostics permission: denied." },
      "actions": [ { "type": "registry", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\appDiagnostics", "name": "Value", "value": "Deny", "kind": "String" } ] },
    { "id": "privacy-edge-diagnostics", "section": "privacy", "risk": "safe", "recommended": true,
      "name": { "uk": "Edge не надсилає діагностичні дані", "en": "Edge sends no diagnostic data" },
      "description": { "uk": "Політика Edge DiagnosticData = 0.", "en": "Edge policy DiagnosticData = 0." },
      "actions": [ { "type": "registry", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge", "name": "DiagnosticData", "value": 0, "kind": "DWord" } ] },
    { "id": "privacy-dev-telemetry", "section": "privacy", "risk": "safe", "recommended": true,
      "name": { "uk": "Без телеметрії PowerShell 7 і .NET", "en": "No PowerShell 7 and .NET telemetry" },
      "description": { "uk": "Змінні середовища POWERSHELL_TELEMETRY_OPTOUT і DOTNET_CLI_TELEMETRY_OPTOUT. Діють для нових вікон програм.", "en": "POWERSHELL_TELEMETRY_OPTOUT and DOTNET_CLI_TELEMETRY_OPTOUT environment variables; apply to newly started programs." },
      "actions": [
        { "type": "registry", "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment", "name": "POWERSHELL_TELEMETRY_OPTOUT", "value": "1", "kind": "String" },
