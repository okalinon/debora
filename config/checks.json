{
  "schema": 1,
  "note": "Перевірки сканера. probe — функція з src/scan/*.ps1; Test-D9RegistryRule / Test-D9ServiceRule / Test-D9EventRule працюють лише з params (див. ProbesRules.ps1). requires — як у твіків.",
  "categories": [
    { "id": "security",    "weight": 3,   "name": { "uk": "Безпека",          "en": "Security" } },
    { "id": "updates",     "weight": 2,   "name": { "uk": "Оновлення",        "en": "Updates" } },
    { "id": "disk",        "weight": 2,   "name": { "uk": "Диск",             "en": "Disk" } },
    { "id": "stability",   "weight": 2,   "name": { "uk": "Стабільність",     "en": "Stability" } },
    { "id": "backup",      "weight": 1.5, "name": { "uk": "Резервні копії",   "en": "Backup" } },
    { "id": "performance", "weight": 1.5, "name": { "uk": "Швидкодія",        "en": "Performance" } },
    { "id": "cleanliness", "weight": 1,   "name": { "uk": "Чистота",          "en": "Cleanliness" } },
    { "id": "privacy",     "weight": 1,   "name": { "uk": "Конфіденційність", "en": "Privacy" } },
    { "id": "network",     "weight": 1,   "name": { "uk": "Мережа",           "en": "Network" } },
    { "id": "battery",     "weight": 1,   "name": { "uk": "Батарея",          "en": "Battery" } }
  ],
  "checks": [

    { "id": "sec.windows-support", "category": "security", "probe": "Test-D9WindowsSupport", "name": { "uk": "Підтримка версії Windows", "en": "Windows version support" }, "thresholds": { "warnDays": 60 } },
    { "id": "sec.antivirus", "category": "security", "probe": "Test-D9Antivirus", "name": { "uk": "Антивірусний захист", "en": "Antivirus protection" }, "thresholds": { "signatureAgeDays": 3 } },
    { "id": "sec.defender-config", "category": "security", "probe": "Test-D9DefenderConfig", "name": { "uk": "Налаштування Захисника Windows", "en": "Microsoft Defender settings" } },
    { "id": "sec.firewall", "category": "security", "probe": "Test-D9Firewall", "name": { "uk": "Брандмауер", "en": "Firewall" } },
    { "id": "sec.uac", "category": "security", "probe": "Test-D9Uac", "name": { "uk": "Контроль облікових записів (UAC)", "en": "User Account Control" } },
    { "id": "sec.secure-boot", "category": "security", "probe": "Test-D9SecureBoot", "name": { "uk": "Безпечне завантаження", "en": "Secure Boot" } },
    { "id": "sec.guest-account", "category": "security", "probe": "Test-D9GuestAccount", "name": { "uk": "Обліковий запис «Гість»", "en": "Guest account" } },
    { "id": "sec.proxy-hosts", "category": "security", "probe": "Test-D9ProxyHosts", "name": { "uk": "Проксі та файл hosts", "en": "Proxy and hosts file" } },
    { "id": "sec.suspicious-autostart", "category": "security", "probe": "Test-D9SuspiciousAutostart", "name": { "uk": "Підозрілий автозапуск", "en": "Suspicious autostart" } },
    { "id": "sec.risky-software", "category": "security", "probe": "Test-D9RiskySoftware", "name": { "uk": "Вразливі та непідтримувані програми", "en": "Vulnerable and unsupported software" } },
    { "id": "sec.unsigned-drivers", "category": "security", "probe": "Test-D9UnsignedDrivers", "name": { "uk": "Драйвери без підпису", "en": "Unsigned drivers" } },
    { "id": "sec.disk-encryption", "category": "security", "probe": "Test-D9DiskEncryption", "adminOnly": true, "name": { "uk": "Шифрування диска ноутбука", "en": "Laptop disk encryption" } },

    { "id": "sec.smartscreen-policy", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "SmartScreen (політика)", "en": "SmartScreen policy" },
      "params": { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "EnableSmartScreen", "bad": { "op": "eq", "value": 0 }, "severity": "warning",
        "title": { "uk": "SmartScreen вимкнено політикою" }, "details": { "uk": "Windows не попереджає про невідомі й шкідливі завантажені програми. Якщо ви цього не робили навмисно — увімкніть SmartScreen." },
        "links": [ { "label": { "uk": "Захист на основі репутації" }, "url": "windowsdefender://smartscreen" } ] } },
    { "id": "sec.smartscreen-explorer", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "SmartScreen для файлів", "en": "SmartScreen for files" },
      "params": { "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer", "name": "SmartScreenEnabled", "bad": { "op": "eq", "value": "Off" }, "severity": "warning",
        "title": { "uk": "SmartScreen для завантажених файлів вимкнено" }, "details": { "uk": "Запуск завантажених .exe відбувається без перевірки репутації." },
        "links": [ { "label": { "uk": "Захист на основі репутації" }, "url": "windowsdefender://smartscreen" } ] } },
    { "id": "sec.uac-secure-desktop", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Захищений робочий стіл UAC", "en": "UAC secure desktop" },
      "params": { "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "PromptOnSecureDesktop", "bad": { "op": "eq", "value": 0 }, "severity": "suggestion",
        "title": { "uk": "Запит UAC показується без затемнення екрана" }, "details": { "uk": "Без захищеного робочого столу шкідлива програма може «натиснути» кнопку в запиті UAC. Поверніть стандартний рівень UAC." } } },
    { "id": "sec.rdp", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Віддалений робочий стіл", "en": "Remote Desktop" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server", "name": "fDenyTSConnections", "bad": { "op": "eq", "value": 0 }, "severity": "suggestion",
        "title": { "uk": "Увімкнено віддалений робочий стіл (RDP)" }, "details": { "uk": "Якщо ви не підключаєтесь до цього ПК віддалено — вимкніть: менше способів атаки." },
        "links": [ { "label": { "uk": "Віддалений робочий стіл" }, "url": "ms-settings:remotedesktop" } ] } },
    { "id": "sec.rdp-nla", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Автентифікація RDP (NLA)", "en": "RDP Network Level Authentication" },
      "params": { "onlyIf": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server", "name": "fDenyTSConnections", "op": "eq", "value": 0 },
        "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp", "name": "UserAuthentication", "bad": { "op": "eq", "value": 0 }, "severity": "warning",
        "title": { "uk": "RDP приймає підключення без попередньої автентифікації (NLA)" }, "details": { "uk": "Без NLA сервер RDP відкритий для атак до введення пароля. Увімкніть «Вимагати автентифікацію на рівні мережі»." } } },
    { "id": "sec.remote-assistance", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Віддалений помічник", "en": "Remote Assistance" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Remote Assistance", "name": "fAllowToGetHelp", "bad": { "op": "eq", "value": 1 }, "severity": "suggestion",
        "title": { "uk": "Увімкнено «Віддалений помічник»" }, "details": { "uk": "Шахраї під виглядом «техпідтримки» часто просять підключитися саме так. Якщо не користуєтесь — вимкніть: sysdm.cpl → Віддалений доступ." },
        "links": [ { "label": { "uk": "Віддалений доступ" }, "url": "SystemPropertiesRemote.exe" } ] } },
    { "id": "sec.smb1-client", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Клієнт SMB1", "en": "SMB1 client" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\mrxsmb10", "name": "Start", "bad": { "op": "ne", "value": 4 }, "severity": "warning",
        "title": { "uk": "Увімкнено застарілий протокол SMB1" }, "details": { "uk": "Через SMB1 поширювались WannaCry і NotPetya." }, "fix": { "type": "tweaks", "ids": ["safety.disable-smb1"] } } },
    { "id": "sec.smb1-server", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Сервер SMB1", "en": "SMB1 server" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters", "name": "SMB1", "bad": { "op": "eq", "value": 1 }, "severity": "warning",
        "title": { "uk": "Спільні папки доступні через SMB1" }, "details": { "uk": "Застарілий і вразливий протокол обміну файлами." }, "fix": { "type": "tweaks", "ids": ["safety.disable-smb1"] } } },
    { "id": "sec.wdigest", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Паролі в пам'яті (WDigest)", "en": "WDigest plaintext credentials" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\WDigest", "name": "UseLogonCredential", "bad": { "op": "eq", "value": 1 }, "severity": "critical",
        "title": { "uk": "Windows зберігає паролі у відкритому вигляді в пам'яті (WDigest)" }, "details": { "uk": "Так налаштовують шкідливі програми, щоб красти паролі (Mimikatz). Видаліть значення UseLogonCredential і перевірте ПК антивірусом." } } },
    { "id": "sec.spectre-mitigations", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Захист від Spectre/Meltdown", "en": "Spectre/Meltdown mitigations" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Memory Management", "name": "FeatureSettingsOverride", "bad": { "op": "eq", "value": 3 }, "severity": "warning",
        "title": { "uk": "Вимкнено захист процесора від Spectre/Meltdown" }, "details": { "uk": "Так роблять деякі «прискорювачі». Виграш у швидкості мізерний, а сайти й програми можуть читати чужу пам'ять. Видаліть FeatureSettingsOverride і FeatureSettingsOverrideMask." } } },
    { "id": "sec.hidden-extensions", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Приховані розширення файлів", "en": "Hidden file extensions" },
      "params": { "path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "HideFileExt", "bad": { "op": "ne", "value": 0, "missing": "bad" }, "severity": "suggestion",
        "title": { "uk": "Розширення файлів приховані" }, "details": { "uk": "Файл «рахунок.pdf.exe» виглядає як «рахунок.pdf» — класична пастка. Показ розширень захищає від неї." }, "fix": { "type": "tweaks", "ids": ["ui.explorer"] } } },
    { "id": "sec.boot-options", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Параметри завантаження", "en": "Boot options" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control", "name": "SystemStartOptions", "bad": { "op": "match", "value": "TESTSIGNING|DISABLE_INTEGRITY_CHECKS|DEBUG" }, "severity": "warning",
        "title": { "uk": "Windows завантажується з вимкненою перевіркою драйверів ({value})" }, "details": { "uk": "Тестовий режим або налагодження дозволяє завантажувати непідписані драйвери. Якщо це не ви — від адміністратора: bcdedit /set testsigning off, bcdedit /set nointegritychecks off." } } },
    { "id": "sec.defender-policy", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Захисник вимкнено політикою", "en": "Defender disabled by policy" },
      "params": { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender", "name": "DisableAntiSpyware", "bad": { "op": "eq", "value": 1 }, "severity": "warning",
        "title": { "uk": "Захисник Windows вимкнено через політику" }, "details": { "uk": "Так його вимикають «оптимізатори» та віруси. Якщо у вас немає іншого антивіруса — видаліть цей параметр і перезавантажте ПК." } } },
    { "id": "sec.lsa-protection", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Захист LSA", "en": "LSA protection" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RunAsPPL", "bad": { "op": "eq", "value": 0, "missing": "bad" }, "severity": "info",
        "title": { "uk": "Захист LSA (ізоляція процесу входу) не увімкнено" }, "details": { "uk": "Ускладнює крадіжку паролів з пам'яті. Увімкнути: Безпека Windows → Безпека пристрою → Ізоляція ядра → Захист LSA." } } },
    { "id": "sec.llmnr", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "LLMNR", "en": "LLMNR" },
      "params": { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient", "name": "EnableMulticast", "bad": { "op": "ne", "value": 0, "missing": "bad" }, "severity": "info",
        "title": { "uk": "Увімкнено LLMNR (застарілий пошук імен у мережі)" }, "details": { "uk": "У публічних Wi-Fi через LLMNR можна перехопити хеш пароля. Для домашнього ПК ризик невеликий; вимикається груповою політикою." } } },
    { "id": "sec.ps-policy", "category": "security", "probe": "Test-D9RegistryRule", "name": { "uk": "Політика виконання PowerShell", "en": "PowerShell execution policy" },
      "params": { "path": "HKLM:\\SOFTWARE\\Microsoft\\PowerShell\\1\\ShellIds\\Microsoft.PowerShell", "name": "ExecutionPolicy", "bad": { "op": "in", "value": ["Unrestricted", "Bypass"] }, "severity": "info",
        "title": { "uk": "PowerShell дозволяє запуск будь-яких скриптів ({value})" }, "details": { "uk": "Для звичайного ПК достатньо RemoteSigned: Set-ExecutionPolicy RemoteSigned від адміністратора." } } },
    { "id": "sec.firewall-service", "category": "security", "probe": "Test-D9ServiceRule", "name": { "uk": "Служба брандмауера", "en": "Firewall service" },
      "params": { "name": "mpssvc", "badStartup": ["Disabled"], "severity": "critical",
        "title": { "uk": "Службу брандмауера Windows вимкнено" }, "details": { "uk": "Без неї брандмауер не працює взагалі. Поверніть тип запуску «Автоматично» (через реєстр, бо services.msc це блокує) або скиньте налаштування брандмауера." } } },
    { "id": "sec.bfe-service", "category": "security", "probe": "Test-D9ServiceRule", "name": { "uk": "Служба фільтрації (BFE)", "en": "Base Filtering Engine" },
      "params": { "name": "BFE", "badStartup": ["Disabled"], "severity": "critical",
        "title": { "uk": "Службу базової фільтрації (BFE) вимкнено" }, "details": { "uk": "Від неї залежать брандмауер, IPsec і VPN. Поверніть тип запуску «Автоматично»." } } },
    { "id": "sec.security-center", "category": "security", "probe": "Test-D9ServiceRule", "name": { "uk": "Центр безпеки", "en": "Security Center" },
      "params": { "name": "wscsvc", "badStartup": ["Disabled"], "severity": "warning",
        "title": { "uk": "Службу «Центр безпеки» вимкнено" }, "details": { "uk": "Windows не попереджатиме про вимкнений антивірус чи брандмауер." } } },
    { "id": "sec.crypto-service", "category": "security", "probe": "Test-D9ServiceRule", "name": { "uk": "Служба криптографії", "en": "Cryptographic Services" },
      "params": { "name": "CryptSvc", "badStartup": ["Disabled"], "severity": "critical",
        "title": { "uk": "Службу криптографії вимкнено" }, "details": { "uk": "Без неї не перевіряються цифрові підписи й не встановлюються оновлення." } } },
    { "id": "sec.remote-registry", "category": "security", "probe": "Test-D9ServiceRule", "name": { "uk": "Віддалений реєстр", "en": "Remote Registry" },
      "params": { "name": "RemoteRegistry", "badStartup": ["Automatic", "AutomaticDelayed"], "badStatus": ["Running"], "severity": "warning",
        "title": { "uk": "Працює служба «Віддалений реєстр»" }, "details": { "uk": "Дозволяє змінювати реєстр цього ПК по мережі. Домашньому ПК не потрібна." }, "fix": { "type": "tweaks", "ids": ["perf.disable-services"] } } },
    { "id": "sec.ssh-server", "category": "security", "probe": "Test-D9ServiceRule", "name": { "uk": "SSH-сервер", "en": "SSH server" },
      "params": { "name": "sshd", "badStartup": ["Automatic", "AutomaticDelayed"], "severity": "info",
        "title": { "uk": "SSH-сервер запускається автоматично" }, "details": { "uk": "Якщо ви не підключаєтесь до цього ПК по SSH — переведіть службу на «Вручну»." } } },
    { "id": "sec.defender-detections", "category": "security", "probe": "Test-D9EventRule", "name": { "uk": "Знайдені загрози", "en": "Detected threats" },
      "params": { "log": "Microsoft-Windows-Windows Defender/Operational", "ids": [1116], "days": 30, "min": 1, "severity": "warning",
        "title": { "uk": "Захисник знаходив загрози: {count} разів за {days} днів" }, "details": { "uk": "Перегляньте журнал захисту (Безпека Windows → Журнал захисту) і запустіть повне сканування." },
        "links": [ { "label": { "uk": "Безпека Windows" }, "url": "windowsdefender:" } ] } },

    { "id": "backup.restore-points", "category": "backup", "probe": "Test-D9RestorePoints", "adminOnly": true, "name": { "uk": "Точки відновлення", "en": "Restore points" }, "thresholds": { "days": 30 } },
    { "id": "backup.user-files", "category": "backup", "probe": "Test-D9UserBackup", "name": { "uk": "Резервні копії файлів", "en": "File backups" } },
    { "id": "backup.shadow-deleted", "category": "backup", "probe": "Test-D9EventRule", "name": { "uk": "Видалення точок відновлення", "en": "Deleted restore points" },
      "params": { "log": "System", "providers": ["volsnap"], "ids": [25, 35, 36], "days": 30, "min": 1, "severity": "warning",
        "title": { "uk": "Точки відновлення видалялись через брак місця: {count} за {days} днів" }, "details": { "uk": "Windows стирає точки відновлення, коли закінчується місце для них. Звільніть диск або збільште ліміт у «Захисті системи»." } } },

    { "id": "upd.last-update", "category": "updates", "probe": "Test-D9LastUpdate", "name": { "uk": "Останнє оновлення Windows", "en": "Last Windows update" }, "thresholds": { "warnDays": 60 } },
    { "id": "upd.paused", "category": "updates", "probe": "Test-D9UpdatesPaused", "name": { "uk": "Пауза оновлень", "en": "Paused updates" } },
    { "id": "upd.pending-reboot", "category": "updates", "probe": "Test-D9PendingReboot", "name": { "uk": "Очікує перезавантаження", "en": "Pending reboot" } },
    { "id": "upd.problem-devices", "category": "updates", "probe": "Test-D9ProblemDevices", "name": { "uk": "Пристрої без драйвера або з помилкою", "en": "Devices without driver or with errors" } },
    { "id": "upd.gpu-driver", "category": "updates", "probe": "Test-D9GpuDriver", "name": { "uk": "Драйвер відеокарти", "en": "Graphics driver" }, "thresholds": { "discreteDays": 365, "integratedDays": 730 } },
    { "id": "upd.bios", "category": "updates", "probe": "Test-D9Bios", "name": { "uk": "Вік BIOS/UEFI", "en": "BIOS/UEFI age" }, "thresholds": { "years": 4 } },
    { "id": "upd.apps", "category": "updates", "probe": "Test-D9AppUpdates", "deep": true, "name": { "uk": "Оновлення програм (winget)", "en": "App updates (winget)" } },
    { "id": "upd.policy-off", "category": "updates", "probe": "Test-D9RegistryRule", "name": { "uk": "Автооновлення вимкнено політикою", "en": "Automatic updates disabled by policy" },
      "params": { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoUpdate", "bad": { "op": "eq", "value": 1 }, "severity": "warning",
        "title": { "uk": "Автоматичні оновлення Windows вимкнено політикою" }, "details": { "uk": "Виправлення безпеки не встановлюються самі. Якщо ви не оновлюєте Windows вручну регулярно — поверніть автооновлення." } } },
    { "id": "upd.wu-service", "category": "updates", "probe": "Test-D9ServiceRule", "name": { "uk": "Служба Windows Update", "en": "Windows Update service" },
      "params": { "name": "wuauserv", "badStartup": ["Disabled"], "severity": "warning",
        "title": { "uk": "Службу Windows Update вимкнено" }, "details": { "uk": "Оновлення безпеки не встановлюються зовсім. Поверніть тип запуску «Вручну»." } } },
    { "id": "upd.bits-service", "category": "updates", "probe": "Test-D9ServiceRule", "name": { "uk": "Служба BITS", "en": "BITS service" },
      "params": { "name": "BITS", "badStartup": ["Disabled"], "severity": "warning",
