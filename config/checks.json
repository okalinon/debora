    { "id": "perf.search-ssd", "category": "performance", "probe": "Test-D9ServiceRule", "requires": { "hardware": { "systemDisk": ["ssd", "nvme"] } }, "name": { "uk": "Пошук Windows на SSD", "en": "Windows Search on SSD" },
