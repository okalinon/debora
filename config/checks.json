    { "id": "perf.prefetcher", "category": "performance", "probe": "Test-D9RegistryRule", "name": { "uk": "Prefetch", "en": "Prefetch" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Memory Management\\PrefetchParameters", "name": "EnablePrefetcher", "bad": { "op": "eq", "value": 0 }, "severity": "suggestion",
        "title": { "uk": "Prefetch вимкнено" }, "details": { "uk": "Без нього програми й Windows запускаються повільніше. Це залишок старих «оптимізацій» — поверніть EnablePrefetcher = 3." } } },
    { "id": "perf.large-system-cache", "category": "performance", "probe": "Test-D9RegistryRule", "name": { "uk": "Великий системний кеш", "en": "Large system cache" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Memory Management", "name": "LargeSystemCache", "bad": { "op": "eq", "value": 1 }, "severity": "suggestion",
        "title": { "uk": "Увімкнено «великий системний кеш» (режим сервера)" }, "details": { "uk": "На звичайному ПК він забирає пам'ять у програм. Старий «твік» — поверніть LargeSystemCache = 0." } } },
    { "id": "perf.fast-startup-hdd", "category": "performance", "probe": "Test-D9RegistryRule", "requires": { "hardware": { "systemDisk": ["hdd"] } }, "name": { "uk": "Швидкий запуск на HDD", "en": "Fast Startup on HDD" },
      "params": { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power", "name": "HiberbootEnabled", "bad": { "op": "eq", "value": 0 }, "severity": "suggestion",
        "title": { "uk": "«Швидкий запуск» вимкнено, хоча диск — HDD" }, "details": { "uk": "На жорсткому диску швидкий запуск скорочує ввімкнення ПК в рази. Увімкніть: Електроживлення → Дії кнопок живлення → «Увімкнути швидкий запуск»." } } },
    { "id": "perf.game-mode", "category": "performance", "probe": "Test-D9RegistryRule", "name": { "uk": "Ігровий режим", "en": "Game Mode" },
      "params": { "path": "HKCU:\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "bad": { "op": "eq", "value": 0 }, "severity": "info",
