    { "id": "perf.themes-service", "category": "performance", "probe": "Test-D9ServiceRule", "name": { "uk": "Служба тем", "en": "Themes service" },
      "params": { "name": "Themes", "badStartup": ["Disabled"], "severity": "info",
        "title": { "uk": "Службу тем вимкнено" }, "details": { "uk": "Вигляд вікон спрощено до класичного; приросту швидкості це майже не дає." } } },

    { "id": "privacy.profile-tweaks", "category": "privacy", "probe": "Test-D9ProfileTweaks", "name": { "uk": "Телеметрія та реклама", "en": "Telemetry and ads" }, "params": { "categories": ["privacy"] } },
    { "id": "privacy.cloud-clipboard", "category": "privacy", "probe": "Test-D9RegistryRule", "name": { "uk": "Хмарний буфер обміну", "en": "Cloud clipboard" },
      "params": { "path": "HKCU:\\Software\\Microsoft\\Clipboard", "name": "EnableCloudClipboard", "bad": { "op": "eq", "value": 1 }, "severity": "info",
        "title": { "uk": "Буфер обміну синхронізується з хмарою" }, "details": { "uk": "Скопійовані паролі й тексти потрапляють на сервери Microsoft і інші пристрої. Параметри → Система → Буфер обміну." } } },
    { "id": "privacy.typing", "category": "privacy", "probe": "Test-D9RegistryRule", "name": { "uk": "Збір даних введення", "en": "Typing data collection" },
      "params": { "path": "HKCU:\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitTextCollection", "bad": { "op": "eq", "value": 0 }, "severity": "info",
        "title": { "uk": "Windows збирає дані набраного тексту й рукописного введення" }, "details": { "uk": "Вимикається: Параметри → Конфіденційність → Персоналізація рукописного й клавіатурного введення." } } },
    { "id": "privacy.online-speech", "category": "privacy", "probe": "Test-D9RegistryRule", "name": { "uk": "Онлайн-розпізнавання мовлення", "en": "Online speech recognition" },
      "params": { "path": "HKCU:\\Software\\Microsoft\\Speech_OneCore\\Settings\\OnlineSpeechPrivacy", "name": "HasAccepted", "bad": { "op": "eq", "value": 1 }, "severity": "info",
        "title": { "uk": "Увімкнено онлайн-розпізнавання мовлення" }, "details": { "uk": "Голосові запити надсилаються в хмару Microsoft. Параметри → Конфіденційність → Мовлення." } } },
    { "id": "privacy.location", "category": "privacy", "probe": "Test-D9RegistryRule", "name": { "uk": "Доступ до розташування", "en": "Location access" },
      "params": { "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore\\location", "name": "Value", "bad": { "op": "eq", "value": "Allow" }, "severity": "info",
        "title": { "uk": "Застосункам дозволено визначати розташування" }, "details": { "uk": "Перевірте, яким застосункам це справді потрібно: Параметри → Конфіденційність → Розташування." } } },
    { "id": "privacy.app-tracking", "category": "privacy", "probe": "Test-D9RegistryRule", "name": { "uk": "Відстеження запусків програм", "en": "App launch tracking" },
